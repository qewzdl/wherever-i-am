--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aef02a5065741244598b0d076db9ca66, type: 3}
  m_Name: EnemyDifficultyCatalog
  m_EditorClassIdentifier: 
  defaultDifficultyId: 1
  difficulties:
  - difficultyId: 0
    displayName: Easy
    description: Hears half of what you do and forgets you within a couple of seconds. Narrow sight, a slow search, and she looks only near the spot she lost you.
    config: {fileID: 11400000, guid: 9f5a4c9543094b4485d1b43a8ed1f1f7, type: 2}
  - difficultyId: 1
    displayName: Normal
    description: The intended balance. Ordinary hearing, a wide look ahead, a few seconds of memory - she searches the room you left, then moves on.
    config: {fileID: 11400000, guid: b761f25b30c760f4fbdc03fcca735ce9, type: 2}
  - difficultyId: 2
    displayName: Hard
    description: Twice the hearing and remembers you for several seconds after losing sight. Turns and accelerates hard, so corners stop shaking her off, and she sweeps a wide area, stopping to look around.
    config: {fileID: 11400000, guid: 9a93e8ff98d84895b12bdeb48cbd589e, type: 2}
  - difficultyId: 3
    displayName: Extreme
    description: Hears the quietest noise from across the house and sees almost all the way around her. Keeps hunting long after you are out of sight, moves faster than anything below, and searches whole rooms rather than corners.
    config: {fileID: 11400000, guid: fb8aaa923da64dc1883463b01e0e961c, type: 2}
