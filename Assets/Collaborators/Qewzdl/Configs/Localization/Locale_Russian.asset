  entries:
  - English: OK
    Translation: "\u041E\u041A"
  - English: Lobby
    Translation: "\u041B\u043E\u0431\u0431\u0438"
  - English: Players
    Translation: "\u0418\u0433\u0440\u043E\u043A\u0438"
  - English: Start
    Translation: "\u041D\u0430\u0447\u0430\u0442\u044C"
  - English: Ready
    Translation: "\u0413\u043E\u0442\u043E\u0432"
  - English: Room settings
    Translation: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u043A\u043E\u043C\u043D\u0430\u0442\u044B"
  - English: Settings
    Translation: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
  - English: Leave
    Translation: "\u041F\u043E\u043A\u0438\u043D\u0443\u0442\u044C"
  - English: Difficulty
    Translation: "\u0421\u043B\u043E\u0436\u043D\u043E\u0441\u0442\u044C"
  - English: Done
    Translation: "\u0413\u043E\u0442\u043E\u0432\u043E"
  - English: Leave session
    Translation: "\u041F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u0441\u0435\u0441\u0441\u0438\u044E"
  - English: Cancel
    Translation: "\u041E\u0442\u043C\u0435\u043D\u0430"
  - English: Chat
    Translation: "\u0427\u0430\u0442"
  - English: Name
    Translation: "\u0418\u043C\u044F"
  - English: Create lobby
    Translation: "\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u043B\u043E\u0431\u0431\u0438"
  - English: Join lobby
    Translation: "\u0412\u043E\u0439\u0442\u0438 \u0432 \u043B\u043E\u0431\u0431\u0438"
  - English: Quit
    Translation: "\u0412\u044B\u0445\u043E\u0434"
  - English: Wherever I Am
    Translation: Wherever I Am
  - English: Join a lobby
    Translation: "\u0412\u0445\u043E\u0434 \u0432 \u043B\u043E\u0431\u0431\u0438"
  - English: On this network
    Translation: "\u0412 \u044D\u0442\u043E\u0439 \u0441\u0435\u0442\u0438"
  - English: Or by address
    Translation: "\u0418\u043B\u0438 \u043F\u043E \u0430\u0434\u0440\u0435\u0441\u0443"
  - English: Refresh
    Translation: "\u041E\u0431\u043D\u043E\u0432\u0438\u0442\u044C"
  - English: Connect
    Translation: "\u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F"
  - English: Game menu
    Translation: "\u0418\u0433\u0440\u043E\u0432\u043E\u0435 \u043C\u0435\u043D\u044E"
  - English: The match continues while this menu is open.
    Translation: "\u041C\u0430\u0442\u0447 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0441\u044F,
      \u043F\u043E\u043A\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E \u044D\u0442\u043E
      \u043C\u0435\u043D\u044E."
  - English: Back to game
    Translation: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0432 \u0438\u0433\u0440\u0443"
  - English: Main menu
    Translation: "\u0413\u043B\u0430\u0432\u043D\u043E\u0435 \u043C\u0435\u043D\u044E"
  - English: Graphics
    Translation: "\u0413\u0440\u0430\u0444\u0438\u043A\u0430"
  - English: Audio
    Translation: "\u0417\u0432\u0443\u043A"
  - English: Controls
    Translation: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435"
  - English: Interface
    Translation: "\u0418\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441"
  - English: Accessibility
    Translation: "\u0414\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u0441\u0442\u044C"
  - English: Resolution
    Translation: "\u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435"
  - English: Display mode
    Translation: "\u0420\u0435\u0436\u0438\u043C \u044D\u043A\u0440\u0430\u043D\u0430"
  - English: Quality
    Translation: "\u041A\u0430\u0447\u0435\u0441\u0442\u0432\u043E"
  - English: Frame rate
    Translation: "\u0427\u0430\u0441\u0442\u043E\u0442\u0430 \u043A\u0430\u0434\u0440\u043E\u0432"
  - English: Vertical sync
    Translation: "\u0412\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u0430\u044F
      \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u044F"
  - English: Field of view
    Translation: "\u041F\u043E\u043B\u0435 \u0437\u0440\u0435\u043D\u0438\u044F"
  - English: Camera smoothing
    Translation: "\u0421\u0433\u043B\u0430\u0436\u0438\u0432\u0430\u043D\u0438\u0435
      \u043A\u0430\u043C\u0435\u0440\u044B"
  - English: Smoothing amount
    Translation: "\u0421\u0438\u043B\u0430 \u0441\u0433\u043B\u0430\u0436\u0438\u0432\u0430\u043D\u0438\u044F"
  - English: Camera
    Translation: "\u041A\u0430\u043C\u0435\u0440\u0430"
  - English: Camera shake
    Translation: "\u0422\u0440\u044F\u0441\u043A\u0430 \u043A\u0430\u043C\u0435\u0440\u044B"
  - English: Head bob
    Translation: "\u041F\u043E\u043A\u0430\u0447\u0438\u0432\u0430\u043D\u0438\u0435
      \u043F\u0440\u0438 \u0445\u043E\u0434\u044C\u0431\u0435"
  - English: Roll when turning
    Translation: "\u041A\u0440\u0435\u043D \u043F\u0440\u0438 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0435"
  - English: Strafe lean
    Translation: "\u041D\u0430\u043A\u043B\u043E\u043D \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u044B"
  - English: Breathing
    Translation: "\u0414\u044B\u0445\u0430\u043D\u0438\u0435"
  - English: How much the view moves on its own. Zero turns an effect off; Reduced
      motion silences all five at once.
    Translation: "\u041D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043A\u0430\u043C\u0435\u0440\u0430
      \u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F \u0441\u0430\u043C\u0430.
      \u041D\u043E\u043B\u044C \u0432\u044B\u043A\u043B\u044E\u0447\u0430\u0435\u0442
      \u044D\u0444\u0444\u0435\u043A\u0442; \xAB\u041C\u0435\u043D\u044C\u0448\u0435
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F\xBB \u0433\u043B\u0443\u0448\u0438\u0442
      \u0432\u0441\u0435 \u043F\u044F\u0442\u044C \u0440\u0430\u0437\u043E\u043C."
  - English: Master
    Translation: "\u041E\u0431\u0449\u0430\u044F"
  - English: Music
    Translation: "\u041C\u0443\u0437\u044B\u043A\u0430"
  - English: Effects
    Translation: "\u042D\u0444\u0444\u0435\u043A\u0442\u044B"
  - English: Mouse sensitivity
    Translation: "\u0427\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u043C\u044B\u0448\u0438"
  - English: Invert vertical look
    Translation: "\u0418\u043D\u0432\u0435\u0440\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C"
  - English: Crouch
    Translation: "\u041F\u0440\u0438\u0441\u0435\u0434\u0430\u043D\u0438\u0435"
  - English: Language
    Translation: "\u042F\u0437\u044B\u043A"
  - English: Interface opacity
    Translation: "\u0412\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u044C \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430"
  - English: Crosshair size
    Translation: "\u0420\u0430\u0437\u043C\u0435\u0440 \u043F\u0440\u0438\u0446\u0435\u043B\u0430"
  - English: Interface scale
    Translation: "\u041C\u0430\u0441\u0448\u0442\u0430\u0431 \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430"
  - English: Everything on screen, together - controls as well as words.
    Translation: "\u0412\u0441\u0451 \u043D\u0430 \u044D\u043A\u0440\u0430\u043D\u0435
      \u0440\u0430\u0437\u043E\u043C \u2014 \u0438 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B
      \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F, \u0438 \u0442\u0435\u043A\u0441\u0442."
  - English: Text size
    Translation: "\u0420\u0430\u0437\u043C\u0435\u0440 \u0442\u0435\u043A\u0441\u0442\u0430"
  - English: The words alone, for when the buttons are already the right size.
    Translation: "\u0422\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u043A\u0441\u0442
      \u2014 \u043A\u043E\u0433\u0434\u0430 \u043A\u043D\u043E\u043F\u043A\u0438
      \u0443\u0436\u0435 \u043D\u0443\u0436\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u043C\u0435\u0440\u0430."
  - English: Reduced motion
    Translation: "\u041C\u0435\u043D\u044C\u0448\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F"
  - English: Screens open and close without sliding, fading or growing into place.
    Translation: "\u042D\u043A\u0440\u0430\u043D\u044B \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0438 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0431\u0435\u0437
      \u0441\u0434\u0432\u0438\u0433\u043E\u0432, \u0437\u0430\u0442\u0443\u0445\u0430\u043D\u0438\u0439
      \u0438 \u0440\u043E\u0441\u0442\u0430."
  - English: Defaults
    Translation: "\u041F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E"
  - English: Apply
    Translation: "\u041F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C"
  - English: Close
    Translation: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C"
  - English: Revert
    Translation: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C"
  - English: Previous
    Translation: "\u041F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0438\u0439"
  - English: Next
    Translation: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439"
  - English: Toggle
    Translation: "\u041F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435"
  - English: Hold
    Translation: "\u0423\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435"
  - English: Fullscreen
    Translation: "\u041F\u043E\u043B\u043D\u044B\u0439 \u044D\u043A\u0440\u0430\u043D"
  - English: Borderless
    Translation: "\u0411\u0435\u0437 \u0440\u0430\u043C\u043A\u0438"
  - English: Windowed
    Translation: "\u0412 \u043E\u043A\u043D\u0435"
  - English: Unlimited
    Translation: "\u0411\u0435\u0437 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u044F"
  - English: Small
    Translation: "\u041C\u0435\u043B\u043A\u0438\u0439"
  - English: Normal
    Translation: "\u041E\u0431\u044B\u0447\u043D\u0430\u044F"
  - English: Large
    Translation: "\u041A\u0440\u0443\u043F\u043D\u044B\u0439"
  - English: Largest
    Translation: "\u0421\u0430\u043C\u044B\u0439 \u043A\u0440\u0443\u043F\u043D\u044B\u0439"
  - English: One press to crouch, another to stand.
    Translation: "\u041E\u0434\u043D\u043E \u043D\u0430\u0436\u0430\u0442\u0438\u0435
      \u2014 \u043F\u0440\u0438\u0441\u0435\u0441\u0442\u044C, \u0435\u0449\u0451
      \u043E\u0434\u043D\u043E \u2014 \u0432\u0441\u0442\u0430\u0442\u044C."
  - English: Crouched while the key is down, standing the moment it is let go.
    Translation: "\u041F\u0440\u0438\u0441\u0435\u0434\u0430\u0435\u0442, \u043F\u043E\u043A\u0430
      \u043A\u043B\u0430\u0432\u0438\u0448\u0430 \u0437\u0430\u0436\u0430\u0442\u0430,
      \u0438 \u0432\u0441\u0442\u0430\u0451\u0442, \u043A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E
      \u0435\u0451 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B\u0438."
  - English: Reset every setting to its default?
    Translation: "\u0421\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0432\u0441\u0435
      \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u043A \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F\u043C
      \u043F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E?"
  - English: Close without applying the changes?
    Translation: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C, \u043D\u0435 \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u044F
      \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F?"
  - English: Keep these display settings? Reverting in {0} s
    Translation: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u044D\u0442\u0438
      \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u044D\u043A\u0440\u0430\u043D\u0430?
      \u0412\u043E\u0437\u0432\u0440\u0430\u0442 \u0447\u0435\u0440\u0435\u0437 {0}
      \u0441"
  - English: Reset
    Translation: "\u0421\u0431\u0440\u043E\u0441\u0438\u0442\u044C"
  - English: Discard
    Translation: "\u041E\u0442\u0431\u0440\u043E\u0441\u0438\u0442\u044C"
  - English: Keep editing
    Translation: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0443"
  - English: Keep
    Translation: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C"
  - English: Ready up
    Translation: "\u0413\u043E\u0442\u043E\u0432"
  - English: Stand down
    Translation: "\u041E\u0442\u043C\u0435\u043D\u0438\u0442\u044C \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u044C"
  - English: Change
    Translation: "\u0418\u0437\u043C\u0435\u043D\u0438\u0442\u044C"
  - English: Remove
    Translation: "\u0412\u044B\u0433\u043D\u0430\u0442\u044C"
  - English: Close lobby
    Translation: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C \u043B\u043E\u0431\u0431\u0438"
  - English: Owner
    Translation: "\u0425\u043E\u0437\u044F\u0438\u043D"
  - English: Not ready
    Translation: "\u041D\u0435 \u0433\u043E\u0442\u043E\u0432"
  - English: Updating...
    Translation: "\u041E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435..."
  - English: Starting...
    Translation: "\u0417\u0430\u043F\u0443\u0441\u043A..."
  - English: No answer - try again
    Translation: "\u041D\u0435\u0442 \u043E\u0442\u0432\u0435\u0442\u0430 \u2014
      \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451
      \u0440\u0430\u0437"
  - English: '{0} READY'
    Translation: "{0} \u0413\u041E\u0422\u041E\u0412\u042B"
  - English: Remove {0}? They will not be able to join again this session.
    Translation: "\u0412\u044B\u0433\u043D\u0430\u0442\u044C {0}? \u0414\u043E \u043A\u043E\u043D\u0446\u0430
      \u0441\u0435\u0441\u0441\u0438\u0438 \u044D\u0442\u043E\u0442 \u0438\u0433\u0440\u043E\u043A
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u0442."
  - English: Need {0} more to start
    Translation: "\u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0443\u0436\u043D\u043E
      \u0435\u0449\u0451 {0}"
  - English: Ready up when you're prepared
    Translation: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \xAB\u0413\u043E\u0442\u043E\u0432\xBB,
      \u043A\u043E\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0442\u0435 \u0433\u043E\u0442\u043E\u0432\u044B"
  - English: Waiting for {0}
    Translation: "\u0416\u0434\u0451\u043C {0}"
  - English: Waiting for {0} players
    Translation: "\u0416\u0434\u0451\u043C \u0438\u0433\u0440\u043E\u043A\u043E\u0432:
      {0}"
  - English: Starting the match...
    Translation: "\u0417\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u043C \u043C\u0430\u0442\u0447..."
  - English: Only the host can change this
    Translation: "\u042D\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u043C\u0435\u043D\u044F\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u0445\u043E\u0437\u044F\u0438\u043D"
  - English: Everyone is ready - start the match
    Translation: "\u0412\u0441\u0435 \u0433\u043E\u0442\u043E\u0432\u044B \u2014
      \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C"
  - English: Waiting for the host to start
    Translation: "\u0416\u0434\u0451\u043C, \u043A\u043E\u0433\u0434\u0430 \u0445\u043E\u0437\u044F\u0438\u043D
      \u043D\u0430\u0447\u043D\u0451\u0442"
  - English: Waiting for the room...
