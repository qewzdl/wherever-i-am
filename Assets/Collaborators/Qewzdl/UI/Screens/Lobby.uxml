<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- multiplayer-only: taken out of the tree in a singleplayer game by
         LobbyUI - the roster, the door, Ready, the room's size and who owns
         it are all about other people. -->
    <Style src="project://database/Assets/Collaborators/Qewzdl/UI/Styles/Theme.uss?fileID=7433441132597879392&amp;guid=ca5559e6448f84549894374ceeaa586c&amp;type=3#Theme" />
    <ui:Template name="ConnectionDialog" src="project://database/Assets/Collaborators/Qewzdl/UI/Templates/ConnectionDialog.uxml?fileID=9197481963319205126&amp;guid=a3ee74ff77b54dd58f40e6840bedaf3c&amp;type=3#ConnectionDialog" />
    <ui:Template name="ConfirmDialog" src="project://database/Assets/Collaborators/Qewzdl/UI/Templates/ConfirmDialog.uxml?fileID=9197481963319205126&amp;guid=1d9e9df5d8304406b8618e6830c56ab7&amp;type=3#ConfirmDialog" />
    <ui:VisualElement name="Screen" class="screen screen--left screen--curtained">
        <ui:VisualElement name="Panel" class="panel panel--rail">
            <ui:Label text="Lobby" name="Title" class="title enter" />
            <ui:VisualElement name="MatchSetup" class="setup enter enter--2">
                <ui:Label name="SetupMap" class="setup__line" />
                <ui:Label name="SetupDifficulty" class="setup__line" />
                <ui:Label name="SetupOwner" class="setup__note multiplayer-only" />
                <ui:Label name="SetupNotice" class="setup__notice" />
            </ui:VisualElement>
            <ui:ScrollView name="LobbyContent" class="scroll lobby__content enter enter--3 multiplayer-only">
                <ui:VisualElement class="roster__header">
                    <ui:Label text="Players" class="section section--flush" />
                    <ui:VisualElement class="roster__summary">
                        <ui:Label name="ReadyCount" class="roster__ready-count" />
                        <ui:Label name="PlayerCount" class="section section--flush" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Roster" class="roster" />
            </ui:ScrollView>
            <ui:VisualElement name="Door" class="door rail__gap enter enter--4 multiplayer-only">
                <ui:VisualElement class="door__state">
                    <ui:Label name="DoorStatus" class="door__status" />
                    <ui:Toggle name="Visibility" class="toggle door__switch" />
                </ui:VisualElement>
                <ui:VisualElement name="AddressField" class="door__address">
                    <ui:DropdownField name="AddressPick" class="field__control door__pick" />
                    <ui:Button name="CopyAddressButton" tooltip="Copy invite address" class="button field__control address-copy">
                        <ui:Label name="Address" class="field__control--code address-copy__value" />
                        <ui:Image name="AddressCopyIcon" class="address-copy__icon" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:Label name="DoorHint" class="hint" />
            </ui:VisualElement>
            <ui:VisualElement class="stack enter enter--5">
                <ui:Label name="StartHint" class="hint" />
                <ui:Button text="Start" name="StartButton" class="button" />
                <ui:Button text="Ready" name="ReadyButton" class="button multiplayer-only" />
                <ui:Button text="Room settings" name="RoomSettingsButton" class="button" />
                <!-- The game's own settings, not the room's. Above Leave for
                     the same reason the main menu and the pause menu put it
                     there: it is the last thing you do here that is not
                     going somewhere else. -->
                <ui:Button text="Settings" name="SettingsButton" class="button" />
                <ui:Button text="Leave" name="LeaveButton" class="button button--cancel" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- The map the match is on, as the tall picture the map screen showed
             when it was chosen, with its name - in the corner the stage and
             the rail leave free, clear of the chat below it. -->
        <ui:VisualElement name="MapCard" picking-mode="Ignore" class="lobby-map enter enter--3">
            <ui:VisualElement name="SetupPreview" picking-mode="Ignore" class="lobby-map__preview" />
            <ui:Label name="MapCardName" picking-mode="Ignore" class="lobby-map__name" />
        </ui:VisualElement>
        <ui:VisualElement name="RoomSettingsPanel" class="overlay">
            <ui:VisualElement class="panel panel--wide">
                <ui:Label text="Room settings" name="RoomSettingsTitle" class="title" />
                <SettingRow setting="MaxPlayers" label="Players" control="Dropdown" class="multiplayer-only" />
                <ui:Label name="MaxPlayersNote" class="hint hint--field multiplayer-only" />
                <SettingRow setting="Difficulty" label="Difficulty" control="Dropdown" />
                <ui:Label name="DifficultyDescription" class="hint hint--field" />
                <ui:Label name="DifficultyOwnerNote" class="hint hint--field multiplayer-only" />
                <ui:VisualElement class="footer">
                    <ui:Button text="Done" name="RoomSettingsCloseButton" class="button button--cancel" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Instance template="ConnectionDialog" name="MatchTransitionPanel" class="overlay">
            <ui:AttributeOverrides element-name="CancelButton" text="Leave session" />
        </ui:Instance>
        <ui:Instance template="ConfirmDialog" name="ConfirmPanel" class="overlay" />
    </ui:VisualElement>
</ui:UXML>
