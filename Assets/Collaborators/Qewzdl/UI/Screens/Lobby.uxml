<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Collaborators/Qewzdl/UI/Styles/Theme.uss?fileID=7433441132597879392&amp;guid=ca5559e6448f84549894374ceeaa586c&amp;type=3#Theme" />
    <ui:VisualElement name="Screen" class="screen screen--left">
        <ui:VisualElement name="Panel" class="panel panel--rail">
            <ui:Label text="Lobby" name="Title" class="title enter" />
            <ui:VisualElement name="MatchSetup" class="setup enter enter--2">
                <ui:Label name="SetupDifficulty" class="setup__line" />
                <ui:Label name="SetupOwner" class="setup__note" />
                <ui:Label name="SetupNotice" class="setup__notice" />
            </ui:VisualElement>
            <ui:ScrollView name="LobbyContent" class="scroll lobby__content enter enter--3">
                <ui:VisualElement class="roster__header">
                    <ui:Label text="Players" class="section section--flush" />
                    <ui:VisualElement class="roster__summary">
                        <ui:Label name="ReadyCount" class="roster__ready-count" />
                        <ui:Label name="PlayerCount" class="section section--flush" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Roster" class="roster" />
            </ui:ScrollView>
            <ui:VisualElement name="Door" class="door rail__gap enter enter--4">
                <ui:VisualElement class="door__state">
                    <ui:Label name="DoorStatus" class="door__status" />
                    <ui:Toggle name="Visibility" class="toggle door__switch" />
                </ui:VisualElement>
                <ui:VisualElement name="AddressField" class="door__address">
                    <ui:DropdownField name="AddressPick" class="field__control door__pick" />
                    <ui:Button name="CopyAddressButton" tooltip="Copy invite address" class="button field__control address-copy">
                        <ui:Label name="Address" class="field__control--code address-copy__value" />
                        <ui:Image name="AddressCopyIcon" class="address-copy__icon" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:Label name="DoorHint" class="hint" />
            </ui:VisualElement>
            <ui:VisualElement class="stack enter enter--5">
                <ui:Label name="StartHint" class="hint" />
                <ui:Button text="Start" name="StartButton" class="button" />
                <ui:Button text="Ready" name="ReadyButton" class="button" />
                <ui:Button text="Room settings" name="RoomSettingsButton" class="button" />
                <ui:Button text="Leave" name="LeaveButton" class="button button--cancel" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="RoomSettingsPanel" class="overlay">
            <ui:VisualElement class="panel panel--wide">
                <ui:Label text="Room settings" class="title" />
                <ui:VisualElement class="field">
                    <ui:Label text="Difficulty" class="field__label" />
                    <ui:DropdownField name="Difficulty" class="field__control" />
                </ui:VisualElement>
                <ui:Label name="DifficultyDescription" class="hint hint--field" />
                <ui:Label name="DifficultyOwnerNote" class="hint hint--field" />
                <ui:VisualElement class="footer">
                    <ui:Button text="Done" name="RoomSettingsCloseButton" class="button button--cancel" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="MatchTransitionPanel" class="overlay">
            <ui:VisualElement class="panel panel--dialog">
                <ui:Label name="MatchTransitionStage" class="section connection-status__step" />
                <ui:Label name="MatchTransitionText" class="question" />
                <ui:Label name="MatchTransitionDetail" class="hint connection-status__detail" />
                <ui:Label name="MatchTransitionElapsed" class="hint connection-status__elapsed" />
                <ui:VisualElement class="footer">
                    <ui:Button text="Leave session" name="TransitionLeaveButton" class="button button--cancel" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ConfirmPanel" class="overlay">
            <ui:VisualElement class="panel panel--dialog">
                <ui:Label name="ConfirmText" class="question" />
                <ui:VisualElement class="footer">
                    <ui:Button name="ConfirmButton" class="button button--danger" />
                    <ui:Button text="Cancel" name="ConfirmCancelButton" class="button button--cancel" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
