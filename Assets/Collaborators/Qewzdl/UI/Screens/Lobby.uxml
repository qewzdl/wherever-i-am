<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Collaborators/Qewzdl/UI/Styles/Theme.uss?fileID=7433441132597879392&amp;guid=ca5559e6448f84549894374ceeaa586c&amp;type=3#Theme" />
    <ui:VisualElement name="Screen" class="screen screen--left">
        <ui:VisualElement name="Panel" class="panel panel--rail">
            <ui:Label text="Lobby" name="Title" class="title title--display rail__item" />
            <ui:VisualElement class="roster__header rail__item rail__item--2">
                <ui:Label text="Players" class="section section--flush" />
                <ui:Label name="PlayerCount" class="section section--flush" />
            </ui:VisualElement>
            <ui:VisualElement name="Roster" class="roster rail__item rail__item--2" />
            <ui:VisualElement class="field rail__item rail__item--3">
                <ui:Label text="Difficulty" class="field__label" />
                <ui:DropdownField name="Difficulty" class="field__control" />
            </ui:VisualElement>
            <ui:Label name="DifficultyDescription" class="hint hint--field rail__item rail__item--3" />
            <ui:VisualElement name="AddressField" class="field rail__item rail__item--3">
                <ui:Label text="Address" class="field__label" />
                <ui:Button name="Address" class="button field__control field__control--code" />
            </ui:VisualElement>
            <ui:VisualElement class="field rail__item rail__item--3">
                <ui:Label text="Door" class="field__label" />
                <ui:Toggle name="Visibility" class="field__control" />
            </ui:VisualElement>
            <ui:Label name="DoorHint" class="hint hint--field rail__item rail__item--3" />
            <ui:VisualElement class="stack rail__gap rail__item rail__item--4">
                <ui:Label name="StartHint" class="hint" />
                <ui:Button text="Start" name="StartButton" class="button button--confirm" />
                <ui:Button text="Ready" name="ReadyButton" class="button" />
                <ui:Button text="Leave" name="LeaveButton" class="button button--cancel" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ConfirmPanel" class="overlay">
            <ui:VisualElement class="panel panel--dialog">
                <ui:Label name="ConfirmText" class="question" />
                <ui:VisualElement class="footer">
                    <ui:Button name="ConfirmButton" class="button button--danger" />
                    <ui:Button text="Cancel" name="ConfirmCancelButton" class="button button--cancel" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
