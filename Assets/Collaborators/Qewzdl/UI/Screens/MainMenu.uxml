<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Collaborators/Qewzdl/UI/Styles/Theme.uss?fileID=7433441132597879392&amp;guid=ca5559e6448f84549894374ceeaa586c&amp;type=3#Theme" />
    <ui:VisualElement name="Screen" class="screen screen--left">
        <ui:VisualElement name="Backdrop" picking-mode="Ignore" class="backdrop">
            <ui:VisualElement picking-mode="Ignore" class="backdrop__shade" />
        </ui:VisualElement>
        <ui:VisualElement name="Panel" class="menu">
            <ui:Label text="Name" class="hint enter enter--2" />
            <ui:TextField name="PlayerName" max-length="16" class="input enter enter--3" />
            <ui:VisualElement class="stack enter enter--4">
                <ui:Button text="Create lobby" name="HostButton" class="button button--confirm" />
                <ui:Button text="Join lobby" name="JoinButton" class="button" />
                <ui:Button text="Settings" name="SettingsButton" class="button" />
                <ui:Button text="Quit" name="QuitButton" class="button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Masthead" picking-mode="Ignore" class="masthead enter">
            <ui:Label text="Wherever I Am" name="Title" class="title title--display" />
        </ui:VisualElement>
        <ui:VisualElement name="JoinPanel" class="overlay">
            <ui:VisualElement class="panel panel--wide">
                <ui:Label text="Join a lobby" class="question" />
                <!-- The rooms that have said they are open. A host broadcasts
                     while its door is open, and this asks out loud every couple
                     of seconds as well - because a machine is entitled to drop
                     a broadcast addressed to nobody, and several do. -->
                <ui:VisualElement class="browser__header">
                    <ui:Label text="On this network" class="section section--flush" />
                    <ui:Label name="BrowserStatus" class="browser__status" />
                </ui:VisualElement>
                <ui:ScrollView name="Browser" class="scroll browser" />
                <!-- The other half of the panel, and it gets a heading like the
                     first half rather than a note dressed as one. It used to
                     wear the field hint modifier, which indents by a whole
                     label column so that a note lands under the control it
                     explains - and there is no label column here, so it landed
                     under nothing. Why somebody would type an address moved
                     down to the line under the field, which is where a field
                     explains itself. -->
                <ui:Label text="Or by address" class="section" />
                <ui:TextField name="Address" class="input" />
                <ui:Label name="AddressHint" class="hint input__hint" />
                <ui:VisualElement class="footer">
                    <ui:Button text="Refresh" name="RefreshButton" class="button" />
                    <ui:Button text="Connect" name="ConnectButton" class="button button--confirm" />
                    <ui:Button text="Cancel" name="CancelJoinButton" class="button button--cancel" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BusyPanel" class="overlay">
            <ui:VisualElement class="panel panel--dialog">
                <ui:Label name="BusyStep" class="section connection-status__step" />
                <ui:Label name="BusyText" class="question" />
                <ui:Label name="BusyDetail" class="hint connection-status__detail" />
                <ui:Label name="BusyElapsed" class="hint connection-status__elapsed" />
                <ui:VisualElement class="footer">
                    <ui:Button text="Cancel" name="CancelRequestButton" class="button button--cancel" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
