<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Collaborators/Qewzdl/UI/Styles/Theme.uss?fileID=7433441132597879392&amp;guid=ca5559e6448f84549894374ceeaa586c&amp;type=3#Theme" />
    <ui:Template name="ConnectionDialog" src="project://database/Assets/Collaborators/Qewzdl/UI/Templates/ConnectionDialog.uxml?fileID=9197481963319205126&amp;guid=a3ee74ff77b54dd58f40e6840bedaf3c&amp;type=3#ConnectionDialog" />
    <ui:VisualElement name="Screen" class="screen screen--left screen--curtained">
        <ui:VisualElement name="Backdrop" picking-mode="Ignore" class="backdrop">
            <ui:VisualElement picking-mode="Ignore" class="backdrop__shade" />
        </ui:VisualElement>
        <ui:VisualElement name="Vignette" picking-mode="Ignore" class="vignette" />
        <ui:VisualElement name="Panel" class="menu">
            <ui:Label text="Name" class="hint enter enter--2" />
            <ui:TextField name="PlayerName" max-length="16" class="input enter enter--3" />
            <ui:VisualElement name="MainButtons" class="stack enter enter--4">
                <ui:Button text="Start game" name="PlayButton" class="button button--confirm" />
                <ui:Button text="Settings" name="SettingsButton" class="button" />
                <ui:Button text="Quit" name="QuitButton" class="button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Masthead" picking-mode="Ignore" class="masthead enter">
            <ui:Label text="Wherever I Am" name="Title" class="title title--display" />
        </ui:VisualElement>
        <!-- Play: alone or with others, as a screen of its own over the same
             picture - two large buttons, each a picture of what it does with
             its name under it. Back or Escape returns to the menu; Back from
             the maps returns here when the map was for a game alone, and
             Back from Create and Join always does. -->
        <ui:VisualElement name="PlayScreen" class="choice-screen">
            <ui:VisualElement class="choice-screen__choices">
                <ui:Button name="SingleplayerButton" class="picture-choice">
                    <ui:VisualElement picking-mode="Ignore" class="picture-choice__picture picture-choice__picture--singleplayer" />
                    <ui:Label text="Singleplayer" picking-mode="Ignore" class="picture-choice__caption" />
                </ui:Button>
                <ui:Button name="MultiplayerButton" class="picture-choice picture-choice--later">
                    <ui:VisualElement picking-mode="Ignore" class="picture-choice__picture picture-choice__picture--multiplayer" />
                    <ui:Label text="Multiplayer" picking-mode="Ignore" class="picture-choice__caption" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="choice-screen__footer">
                <ui:Button text="Back" name="PlayBackButton" class="button button--cancel" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Create or join, as a screen of its own over the same picture: two
             large buttons, each a picture of what it does with its name under
             it. Back or Escape returns to Play, and Back from the map screen
             returns here. -->
        <ui:VisualElement name="MultiplayerScreen" class="choice-screen">
            <ui:VisualElement class="choice-screen__choices">
                <ui:Button name="HostButton" class="picture-choice">
                    <ui:VisualElement picking-mode="Ignore" class="picture-choice__picture picture-choice__picture--create" />
                    <ui:Label text="Create lobby" picking-mode="Ignore" class="picture-choice__caption" />
                </ui:Button>
                <ui:Button name="JoinButton" class="picture-choice picture-choice--later">
                    <ui:VisualElement picking-mode="Ignore" class="picture-choice__picture picture-choice__picture--join" />
                    <ui:Label text="Join lobby" picking-mode="Ignore" class="picture-choice__caption" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement class="choice-screen__footer">
                <ui:Button text="Back" name="BackButton" class="button button--cancel" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Which map, before anything else: a host opens a room for one, and
             somebody looking to join looks for rooms playing one. A screen of
             its own over the same picture - the menu and the masthead step
             aside while it is up. One map to a page, in the order they are
             played (see MapProgress), turned from the edges of the frame. -->
        <ui:VisualElement name="MapScreen" class="map-screen">
            <ui:VisualElement name="MapSheet" class="map-screen__page">
                <ui:VisualElement name="MapPreview" class="map-screen__preview">
                    <ui:VisualElement picking-mode="Ignore" class="map-screen__lock" />
                    <ui:Label text="No preview" class="map-screen__no-preview" />
                </ui:VisualElement>
                <ui:VisualElement class="map-screen__text">
                    <ui:Label name="MapName" class="title title--display map-screen__name" />
                    <ui:Label name="MapDescription" class="map-screen__description" />
                    <ui:Label name="MapHint" class="hint map-screen__hint" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="MapDots" picking-mode="Ignore" class="map-screen__dots" />
            <ui:Button name="MapPreviousButton" tooltip="Previous map" class="map-screen__arrow map-screen__arrow--previous" />
            <ui:Button name="MapNextButton" tooltip="Next map" class="map-screen__arrow map-screen__arrow--next" />
            <ui:VisualElement class="map-screen__footer">
                <ui:Button text="Back" name="MapBackButton" class="button button--cancel" />
                <ui:Button name="MapConfirmButton" class="button button--confirm" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- The rooms to join, as a screen of its own over the same picture,
             like the map screen before it: the menu and the masthead step
             aside while it is up, the list takes the height of the frame,
             and what to do with it sits in the bottom corner. -->
        <ui:VisualElement name="JoinScreen" class="join-screen">
            <ui:VisualElement class="join-screen__page">
                <ui:Label text="Join a lobby" class="title join-screen__title" />
                <!-- The rooms that have said they are open. A host broadcasts
                     while its door is open, and this asks out loud every couple
                     of seconds as well - because a machine is entitled to drop
                     a broadcast addressed to nobody, and several do. -->
                <ui:VisualElement class="browser__header">
                    <ui:Label text="On this network" class="section section--flush" />
                    <ui:Label name="BrowserStatus" class="browser__status" />
                </ui:VisualElement>
                <ui:ScrollView name="Browser" class="scroll browser" />
                <!-- The other half of the screen, and it gets a heading like
                     the first half rather than a note dressed as one. Why
                     somebody would type an address is on the line under the
                     field, which is where a field explains itself. -->
                <ui:Label text="Or by address" class="section" />
                <ui:TextField name="Address" class="input" />
                <ui:Label name="AddressHint" class="hint input__hint" />
            </ui:VisualElement>
            <ui:VisualElement class="join-screen__footer">
                <ui:Button name="BrowserFilterButton" class="button" />
                <ui:Button text="Refresh" name="RefreshButton" class="button" />
                <ui:Button text="Back" name="CancelJoinButton" class="button button--cancel" />
                <ui:Button text="Connect" name="ConnectButton" class="button button--confirm" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Instance template="ConnectionDialog" name="BusyPanel" class="overlay" />
    </ui:VisualElement>
</ui:UXML>
