<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Collaborators/Qewzdl/UI/Styles/Theme.uss?fileID=7433441132597879392&amp;guid=ca5559e6448f84549894374ceeaa586c&amp;type=3#Theme" />
    <ui:VisualElement name="Screen" class="screen">
        <ui:VisualElement name="Panel" class="panel panel--narrow">
            <ui:Label text="Game menu" name="Title" class="title title--subtitled" />
            <ui:Label text="The match continues while this menu is open." name="Note" class="hint subtitle" />
            <!-- Not a .stack. That class exists to make four entries touch and
                 read as one list, which is what the main menu and the lobby rail
                 want. Four things you do to a running match are four separate
                 decisions, so they keep the gap a button brings with it. -->
            <ui:VisualElement name="Buttons">
                <ui:Button text="Back to game" name="ResumeButton" class="button" />
                <ui:Button text="Settings" name="SettingsButton" class="button" />
                <ui:Button text="Main menu" name="MainMenuButton" class="button" />
                <ui:Button text="Quit" name="QuitButton" class="button button--danger" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
