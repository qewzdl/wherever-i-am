<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Collaborators/Qewzdl/UI/Styles/Theme.uss?fileID=7433441132597879392&amp;guid=ca5559e6448f84549894374ceeaa586c&amp;type=3#Theme" />
    <ui:Template name="ConfirmDialog" src="project://database/Assets/Collaborators/Qewzdl/UI/Templates/ConfirmDialog.uxml?fileID=9197481963319205126&amp;guid=1d9e9df5d8304406b8618e6830c56ab7&amp;type=3#ConfirmDialog" />
    <ui:VisualElement name="Screen" class="screen">
        <ui:VisualElement name="Panel" class="panel panel--wide panel--settings">
            <ui:Label text="Settings" name="Title" class="title" />
            <ui:VisualElement name="Tabs" class="tabs">
                <ui:Button text="Graphics" name="GraphicsTab" class="button tab" />
                <ui:Button text="Audio" name="AudioTab" class="button tab" />
                <ui:Button text="Controls" name="ControlsTab" class="button tab" />
                <ui:Button text="Interface" name="InterfaceTab" class="button tab" />
                <ui:Button text="Accessibility" name="AccessibilityTab" class="button tab" />
            </ui:VisualElement>
            <ui:ScrollView name="GraphicsPage" class="scroll page">
                <SettingRow setting="Resolution" label="Resolution" control="Dropdown" />
                <SettingRow setting="DisplayMode" label="Display mode" control="Dropdown" />
                <SettingRow setting="Quality" label="Quality" control="Dropdown" />
                <SettingRow setting="FrameRate" label="Frame rate" control="Dropdown" />
                <SettingRow setting="VerticalSync" label="Vertical sync" control="Toggle" />
                <SettingRow setting="FieldOfView" label="Field of view" low-value="60" high-value="110" />
                <SettingRow setting="CameraSmoothing" label="Camera smoothing" control="Toggle" />
                <SettingRow setting="SmoothingIntensity" label="Smoothing amount" low-value="0" high-value="1" />
                <ui:Label text="Camera" class="section" />
                <SettingRow setting="CameraShakeIntensity" label="Camera shake" low-value="0" high-value="1" />
                <SettingRow setting="HeadBobIntensity" label="Head bob" low-value="0" high-value="1" />
                <SettingRow setting="CameraRollIntensity" label="Roll when turning" low-value="0" high-value="1" />
                <SettingRow setting="StrafeLeanIntensity" label="Strafe lean" low-value="0" high-value="1" />
                <SettingRow setting="BreathingIntensity" label="Breathing" low-value="0" high-value="1" />
                <ui:Label text="How much the view moves on its own. Zero turns an effect off; Reduced motion silences all five at once." class="hint hint--field" />
            </ui:ScrollView>
            <ui:ScrollView name="AudioPage" class="scroll page">
                <SettingRow setting="MasterVolume" label="Master" low-value="0" high-value="1" />
                <SettingRow setting="MusicVolume" label="Music" low-value="0" high-value="1" />
                <SettingRow setting="EffectsVolume" label="Effects" low-value="0" high-value="1" />
                <SettingRow setting="InterfaceVolume" label="Interface" low-value="0" high-value="1" />
            </ui:ScrollView>
            <ui:ScrollView name="ControlsPage" class="scroll page">
                <SettingRow setting="MouseSensitivity" label="Mouse sensitivity" low-value="10" high-value="100" />
                <SettingRow setting="InvertVerticalLook" label="Invert vertical look" control="Toggle" />
                <SettingRow setting="CrouchMode" label="Crouch" control="Dropdown" />
                <ui:Label name="CrouchModeHint" class="hint hint--field" />
            </ui:ScrollView>
            <ui:ScrollView name="InterfacePage" class="scroll page">
                <!-- First, because it decides how every other row on every tab
                     reads. Its own choices are not translated: a language is
                     named in itself, or the person looking for it cannot find
                     it. -->
                <SettingRow setting="Language" label="Language" control="Dropdown" />
                <SettingRow setting="InterfaceOpacity" label="Interface opacity" low-value="0.2" high-value="1" />
                <SettingRow setting="CrosshairSize" label="Crosshair size" low-value="0.5" high-value="2" />
            </ui:ScrollView>
            <ui:ScrollView name="AccessibilityPage" class="scroll page">
                <SettingRow setting="UiScale" label="Interface scale" low-value="0.75" high-value="1.5" />
                <ui:Label text="Everything on screen, together - controls as well as words." class="hint hint--field" />
                <SettingRow setting="TextSize" label="Text size" control="Dropdown" />
                <ui:Label text="The words alone, for when the buttons are already the right size." class="hint hint--field" />
                <SettingRow setting="ReducedMotion" label="Reduced motion" control="Toggle" />
                <ui:Label text="Screens open and close without sliding, fading or growing into place." class="hint hint--field" />
            </ui:ScrollView>
            <ui:VisualElement name="Footer" class="footer">
                <ui:Button text="Defaults" name="DefaultsButton" class="button" />
                <ui:Button text="Apply" name="ApplyButton" class="button button--confirm" />
                <ui:Button text="Close" name="CloseButton" class="button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Instance template="ConfirmDialog" name="ConfirmPanel" class="overlay">
            <ui:AttributeOverrides element-name="CancelButton" text="Revert" />
        </ui:Instance>
    </ui:VisualElement>
</ui:UXML>
