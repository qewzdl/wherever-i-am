/* ==========================================================================
   BUTTON

   A word that opens.

   No frame, no block, no bar, no fill. A button here is its own lettering and
   nothing else, and pointing at it does two things at once: the letters come
   up out of the dim, and the spacing between them widens. The word opens.

   That is the whole control. It is the quietest thing this interface could
   have been and still be usable, which is the right register for a game about
   a house nobody is supposed to be inside.

   Three steps of brightness carry all three states, because with the geometry
   gone colour is the only channel left. Dim at rest, bone under the keyboard,
   full bone under the pointer. The tracking opens for both of the last two -
   whichever way you arrive at a button, arriving is what opens it.

   THE THING TO WATCH

   Tracking changes how wide a word is. In a column that costs nothing: the
   entries are full width and the text simply spreads inside its own row. In a
   row of three it would shove the neighbours sideways every time the pointer
   crossed one, so anything that sits in a row is given a width and keeps it.
   That is not a workaround bolted onto the idea - a row of actions all the
   same width is what a row of actions should have looked like anyway.
   ========================================================================== */

.button {
    color: var(--text-dim);
    font-size: var(--text-m);

    letter-spacing: var(--tracking-wide);

    background-color: rgba(0, 0, 0, 0);

    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;

    border-radius: var(--radius);

    padding-top: var(--space-s);
    padding-bottom: var(--space-s);
    padding-left: 0;
    padding-right: 0;

    margin-top: var(--space-xs);
    margin-bottom: var(--space-xs);

    transition-property:
        color,
        letter-spacing;

    transition-duration: var(--motion-normal);
    transition-timing-function: var(--ease-standard);
}


/* Under the keyboard: up out of the dim, and open. Focus gets the movement as
   well as the colour, because a player driving this with a stick is arriving
   at the button in every sense that matters and should see the same thing
   happen. It stops one step short of the pointer's brightness, so when the two
   land on different buttons - which is the normal case the moment anybody
   touches a key - they are still tellable apart. */

.unity-button.button:focus:enabled {
    color: var(--text);

    background-color: rgba(0, 0, 0, 0);

    letter-spacing: var(--tracking-wider);
}


.unity-button.button:hover:enabled {
    color: var(--accent);

    background-color: rgba(0, 0, 0, 0);

    letter-spacing: var(--tracking-wider);
}


/* Held. It closes back down a little rather than going anywhere - the word
   tightening under the finger is the only thing left to press. */

.unity-button.button:active:enabled {
    color: var(--accent-pressed);

    background-color: rgba(0, 0, 0, 0);

    letter-spacing: var(--tracking-wide);

    transition-duration: var(--motion-fast);
}


/* Never opens, because it never will. */

.unity-button.button:disabled {
    color: var(--text-disabled);

    background-color: rgba(0, 0, 0, 0);

    letter-spacing: var(--tracking-wide);

    opacity: 1;
}


/* ==========================================================================
   ROWS

   Everything that sits beside another button is given a width, so a word
   opening never moves the word next to it. In a column nothing needs this:
   the entries are already as wide as the column.

   There is no .button--cancel here on purpose. With the frames gone the base
   button already is the quiet one, and the class stays in the markup because
   the sound binder listens for it - not because it needs a look of its own.
   ========================================================================== */

.footer .button {
    width: 160px;

    -unity-text-align: middle-center;
}


/* ==========================================================================
   CONFIRM

   The action the screen exists for, lit before anybody points at it, so a row
   of three has somewhere for the eye to land. It does not arrive open - the
   opening belongs to the pointer, and a word that arrived open would have
   nothing left to do.
   ========================================================================== */

.button--confirm {
    color: var(--accent);
}


/* ==========================================================================
   DANGER

   The one colour in the interface, spent on the one button that ends
   something. It is worn at rest, because with the geometry gone there is no
   other way to be told which button that is without pointing at each one.

   Rust needs its own bright step. Bone had one already - the accent goes from
   bone to bone-pressed and back - and the rust family only ever had a dark
   half, because it used to be a fill with text on top rather than the text
   itself.
   ========================================================================== */

.button--danger {
    color: var(--danger);
}


.unity-button.button--danger:focus:enabled {
    color: var(--danger);

    letter-spacing: var(--tracking-wider);
}


.unity-button.button--danger:hover:enabled {
    color: var(--danger-hover);

    letter-spacing: var(--tracking-wider);
}


/* Stays rust while it is held: a button that changes hue under the finger
   reads as a different button. */

.unity-button.button--danger:active:enabled {
    color: var(--danger-pressed);

    letter-spacing: var(--tracking-wide);
}
