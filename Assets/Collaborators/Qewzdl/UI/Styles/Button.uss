/* ==========================================================================
   BUTTON

   A frame, and inside it a word that lights - until the pointer arrives, and
   then the two trade places.

   Rest and focus are the frame doing the work: dim, then bone under the
   keyboard, with the label matching it, because a border and its label
   disagreeing about how lit they are is the one thing that makes a button look
   broken. Under the pointer the button inverts - the colour the frame had
   floods the inside of it and the word goes to ink - which is the loudest
   thing a flat interface can say without moving anything.

   Inverting rather than brightening also settles an argument the old version
   was having with itself. Focus and hover were two steps of the same channel,
   and telling bone from slightly-more-bone across a row was work. Now they are
   different in kind: the keyboard outlines, the pointer fills.

   Still nothing moves and nothing changes size, so a row of these can be read
   while the pointer crosses it.

   The frame comes off in two places, and they are two decisions rather than
   one: the main menu's entries in Screen.uss and the lobby's column in
   Panel.uss. In both, a button is a place to go rather than a thing to press
   and a stack of four boxes reads as a form - but the two are different screens
   and each says so where it stands. It is taken off there rather than added
   here because everything else in the game that can be clicked lives in a
   panel.
   ========================================================================== */

.button {
    /* Bone, the same as the frame around it. Dim was the resting step back when
       focus and hover had to be told apart on the word alone; the frame carries
       focus now, which leaves nothing paying for a label a shade under the
       thing it is written on. A button that can be pressed says so at rest. */
    color: var(--text);
    font-size: var(--font-size-m);

    letter-spacing: var(--tracking-wide);

    background-color: var(--transparent);

    /* Bone, and the same bone everywhere a button has a frame. It used to be
       --line-strong, on the reasoning that the edge of a button is a line and
       lines have a role of their own. What that missed is that ink-500 and
       bone-400 sit within twenty of each other, so the frame and the word
       inside it were the same brightness by accident rather than by decision,
       and the frame read as grey against every bone thing beside it.

       So the frame is drawn from the ladder the word is drawn from, one step
       above the resting label: the button is bone at rest, dim inside a bright
       edge, and it is that in the pause menu, in a dialog footer and in the
       lobby alike. Lines still divide things - that is --line, and a button's
       edge was never doing that job. */
    border-color: var(--text);

    border-width: var(--border);

    border-radius: var(--radius);

    padding-top: var(--space-s);
    padding-bottom: var(--space-s);
    padding-left: var(--space-m);
    padding-right: var(--space-m);

    margin-top: var(--space-xs);
    margin-bottom: var(--space-xs);

    /* Nothing down the sides. Unity's theme leaves a few pixels there, which is
       what stopped a column of menu entries lining up with the title above them
       and a footer's last button from meeting the panel's edge. A gap between
       two buttons is a decision the row makes - see .footer .button - not
       something a button brings with it. */
    margin-left: 0;
    margin-right: 0;

    transition-property:
        color,
        background-color,
        border-left-color,
        border-right-color,
        border-top-color,
        border-bottom-color;

    transition-duration: var(--motion-normal);
    transition-timing-function: var(--ease-standard);
}


/* Under the keyboard: the frame brightens a step and nothing else moves. The
   word has nowhere to go - it is bone at rest now - which is fine, because it
   leaves focus and hover different in kind rather than in degree, the way they
   were meant to be: the keyboard rims the box, the pointer floods it.

   The rim is the accent, which is the edge the text field, the toggle and the
   dropdown all take when they hold focus - and stating it is what keeps
   Unity's own blue off the button, the same blue the dropdown had to be talked
   out of. Left unsaid, the default theme paints the one colour this game does
   not own. */

.unity-button.button:focus:enabled {
    background-color: var(--transparent);

    border-color: var(--accent);
}


/* Under the pointer: inverted. The frame keeps its colour and the fill takes
   the same one, so the button does not gain an edge it did not have - it
   becomes the edge. The word goes to ink because there is nothing else it
   could be once the bone is underneath it. */

.unity-button.button:hover:enabled {
    color: var(--text-on-accent);

    background-color: var(--accent);

    border-color: var(--accent);
}


/* Held. A step back down the same fill, and quicker, because a press wants to
   answer before the finger has finished. The word stays ink: it is the surface
   under it that darkens, not the writing. */

.unity-button.button:active:enabled {
    color: var(--text-on-accent);

    background-color: var(--accent-pressed);

    border-color: var(--accent-pressed);

    transition-duration: var(--motion-fast);
}


/* Never lights, because it never will. */

.unity-button.button:disabled {
    color: var(--text-disabled);

    background-color: var(--transparent);

    border-color: var(--text-disabled);

    opacity: 1;
}


/* ==========================================================================
   WHAT IS NOT IN THIS FILE

   Two things, and the line between them is what keeps a button one control
   instead of six.

   This file says what a button means: neutral, confirm, danger. That travels
   with the button, so it is a class on the button.

   Where a button stands is said by whatever it is standing in, next to the
   rule for that place - a row of actions in Field.uss, a column of menu
   entries in Panel.uss, the lobby's own in Lobby.uss. A button does not know
   what it was put inside, and a modifier claiming otherwise would have to be
   kept in step with the markup by hand.

   There is no .button--cancel either. With the frames gone the base button
   already is the quiet one, and the class stays in the markup because the
   sound binder listens for it - not because it needs a look of its own.
   ========================================================================== */

/* ==========================================================================
   CONFIRM

   The action the screen exists for, lit before anybody points at it, so a row
   of three has somewhere for the eye to land. One step short of the pointer's
   brightness, so there is still somewhere for it to go.
   ========================================================================== */

.button--confirm {
    color: var(--accent);

    border-color: var(--accent);
}


/* ==========================================================================
   DANGER

   The one colour in the interface, spent on the one button that ends
   something. It is worn at rest, because with the geometry gone there is no
   other way to be told which button that is without pointing at each one.

   One rust does rest and hover both. What changes between them is not the shade
   but which side of the line the colour is on: a word in a rust frame, then a
   rust field with the word cut out of it. That is a larger difference than any
   two shades of the same hue could be, and it left the pale step with no job -
   it had been the hover, and pale is what made this button look washed out at
   the one moment it is meant to be loud.
   ========================================================================== */

.button--danger {
    color: var(--danger);

    border-color: var(--danger);
}


/* Stated even though it matches the resting colour: the plain focus rule would
   otherwise turn a rust word bone the moment a key is touched. */

.unity-button.button--danger:focus:enabled {
    color: var(--danger);

    border-color: var(--danger);
}


/* Inverts like everything else, in its own hue, and at its own strength. The
   frame does not change colour at all - the rust it was already wearing simply
   floods inwards and the word is cut out of it. This is the one button in the
   game that fills with colour, and it only does it while somebody is pointing
   at the thing that ends the session, which is the moment to be loud rather
   than the moment to go pale. */

.unity-button.button--danger:hover:enabled {
    color: var(--text-on-danger);

    background-color: var(--danger);

    border-color: var(--danger);
}


/* Stays rust while it is held: a button that changes hue under the finger
   reads as a different button. */

.unity-button.button--danger:active:enabled {
    color: var(--text-on-danger);

    background-color: var(--danger-pressed);

    border-color: var(--danger-pressed);
}
