/* ==========================================================================
   BUTTON

   A word that lights.

   No frame, no block, no bar, no fill, and nothing that moves. A button here is
   its own lettering, and pointing at it brings the letters up out of the dim.
   That is the whole control.

   Three steps of brightness carry all three states, because it is the only
   channel there is: dim at rest, bone under the keyboard, full bone under the
   pointer. Nothing is animated but colour, so nothing on the screen changes
   size or position at any point - which is the reason a row of these can be
   read while the pointer is crossing it.
   ========================================================================== */

.button {
    color: var(--text-dim);
    font-size: var(--text-m);

    letter-spacing: var(--tracking-wide);

    background-color: rgba(0, 0, 0, 0);

    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;

    border-radius: var(--radius);

    padding-top: var(--space-s);
    padding-bottom: var(--space-s);
    padding-left: 0;
    padding-right: 0;

    margin-top: var(--space-xs);
    margin-bottom: var(--space-xs);

    transition-property: color;

    transition-duration: var(--motion-normal);
    transition-timing-function: var(--ease-standard);
}


/* Under the keyboard: up out of the dim, but one step short of the pointer's
   brightness. The two land on different buttons the moment anybody touches a
   key, and with a single channel doing all the work they have to stay tellable
   apart on that channel alone. */

.unity-button.button:focus:enabled {
    color: var(--text);

    background-color: rgba(0, 0, 0, 0);
}


.unity-button.button:hover:enabled {
    color: var(--accent);

    background-color: rgba(0, 0, 0, 0);
}


/* Held. A step back down the same three, and quicker, because a press wants to
   answer before the finger has finished. */

.unity-button.button:active:enabled {
    color: var(--accent-pressed);

    background-color: rgba(0, 0, 0, 0);

    transition-duration: var(--motion-fast);
}


/* Never lights, because it never will. */

.unity-button.button:disabled {
    color: var(--text-disabled);

    background-color: rgba(0, 0, 0, 0);

    opacity: 1;
}


/* ==========================================================================
   ROWS

   These widths arrived to stop a hover from shoving the neighbouring word
   sideways, back when hovering changed how wide a word was. Nothing moves any
   more, so they are not holding anything up - they stay because a row of
   actions all the same width is what a row of actions should look like, which
   was true before there was a problem for it to solve.

   A column needs none of this: its entries are already as wide as the column.

   There is no .button--cancel here on purpose. With the frames gone the base
   button already is the quiet one, and the class stays in the markup because
   the sound binder listens for it - not because it needs a look of its own.
   ========================================================================== */

.footer .button {
    width: 160px;

    -unity-text-align: middle-center;
}


/* ==========================================================================
   CONFIRM

   The action the screen exists for, lit before anybody points at it, so a row
   of three has somewhere for the eye to land. One step short of the pointer's
   brightness, so there is still somewhere for it to go.
   ========================================================================== */

.button--confirm {
    color: var(--accent);
}


/* ==========================================================================
   DANGER

   The one colour in the interface, spent on the one button that ends
   something. It is worn at rest, because with the geometry gone there is no
   other way to be told which button that is without pointing at each one.

   Rust needs its own bright step. Bone had one already - the accent goes from
   bone to bone-pressed and back - and the rust family only ever had a dark
   half, because it used to be a fill with text on top rather than the text
   itself.
   ========================================================================== */

.button--danger {
    color: var(--danger);
}


/* Stated even though it matches the resting colour: the plain focus rule would
   otherwise turn a rust word bone the moment a key is touched. */

.unity-button.button--danger:focus:enabled {
    color: var(--danger);
}


.unity-button.button--danger:hover:enabled {
    color: var(--danger-hover);
}


/* Stays rust while it is held: a button that changes hue under the finger
   reads as a different button. */

.unity-button.button--danger:active:enabled {
    color: var(--danger-pressed);
}
