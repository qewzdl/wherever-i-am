/* ==========================================================================
   BUTTON

   A bracket rather than a box.

   Three things were wrong with the boxes. A one pixel rectangle with rounded
   nothing is what every settings dialog written since 2014 looks like, and it
   said nothing about this game. Filling it with bone on hover made the thing
   under the pointer the brightest object on the screen, in a game whose whole
   palette is an argument against that. And the movement - an item leaning six
   pixels towards the cursor, a box shrinking two percent under the click - is
   a web page's idea of feedback, borrowed twice.

   So: the frame is open on two sides and closes when you point at it. At rest
   a button is an L, a corner mark, the kind of thing stencilled on a crate or
   drawn round a thing being measured. Under the pointer the other two sides
   arrive and the mark becomes a frame - the interface closing around what you
   are about to do.

   All four sides are always there and only the colour of two of them changes,
   so nothing moves, nothing reflows, and nothing needs to be animated except
   colour. That is the whole interaction: no travel, no scale, no fill.
   ========================================================================== */

.button {
    color: var(--text);
    font-size: var(--text-m);

    /* Set apart, like the titles. A button is scanned before it is read, and
       spacing is what makes a row of them scannable. */
    letter-spacing: var(--tracking-wide);

    background-color: rgba(0, 0, 0, 0);

    border-left-width: var(--border-strong);
    border-right-width: var(--border-strong);
    border-top-width: var(--border-strong);
    border-bottom-width: var(--border-strong);

    /* The mark: down the left and along the bottom. Two sides present, two
       held open and waiting. */
    border-left-color: var(--line-hover);
    border-bottom-color: var(--line-hover);
    border-top-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);

    border-radius: var(--radius);

    padding-top: var(--space-s);
    padding-bottom: var(--space-s);
    padding-left: var(--space-m);
    padding-right: var(--space-m);

    margin-top: var(--space-xs);
    margin-bottom: var(--space-xs);

    transition-property:
        color,
        border-left-color,
        border-right-color,
        border-top-color,
        border-bottom-color;

    transition-duration: var(--motion-normal);
    transition-timing-function: var(--ease-standard);
}


/* The frame closes and the lettering comes up with it. */

.unity-button.button:hover:enabled {
    color: var(--accent);

    background-color: rgba(0, 0, 0, 0);

    border-left-color: var(--accent);
    border-right-color: var(--accent);
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
}


/* Focus closes it too, but stays dim. The two states have to be tellable apart
   when they land on different buttons - which is the normal case the moment
   anybody touches a key - and the difference is brightness rather than shape,
   because a keyboard and a pointer are pointing at the same kind of thing. */

.unity-button.button:focus:enabled {
    color: var(--text);

    background-color: rgba(0, 0, 0, 0);

    border-left-color: var(--text-dim);
    border-right-color: var(--text-dim);
    border-top-color: var(--text-dim);
    border-bottom-color: var(--text-dim);
}


/* Pressed does not move and does not fill. It goes down a step in brightness,
   which on a frame this thin is the whole difference between held and not. */

.unity-button.button:active:enabled {
    color: var(--accent-pressed);

    background-color: rgba(0, 0, 0, 0);

    border-left-color: var(--accent-pressed);
    border-right-color: var(--accent-pressed);
    border-top-color: var(--accent-pressed);
    border-bottom-color: var(--accent-pressed);

    transition-duration: var(--motion-fast);
}


/* A button that cannot be pressed keeps its mark open, because closing is what
   pressing looks like and this one never will. */

.unity-button.button:disabled {
    color: var(--text-disabled);

    background-color: rgba(0, 0, 0, 0);

    border-left-color: var(--text-disabled);
    border-bottom-color: var(--text-disabled);
    border-top-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);

    opacity: 1;
}


/* ==========================================================================
   CONFIRM AND CANCEL

   The action a screen exists for is marked before anybody points at it, so a
   footer of three has somewhere for the eye to land. It is still an open mark,
   not a closed frame - closing is what the pointer does, and a button that
   arrives closed would read as already pressed.
   ========================================================================== */

.button--confirm {
    color: var(--accent);

    border-left-color: var(--accent);
    border-bottom-color: var(--accent);
}


/* The way out, kept quiet. It has to be findable, not chosen. */

.button--cancel {
    color: var(--text-dim);

    border-left-color: var(--line);
    border-bottom-color: var(--line);
}


/* ==========================================================================
   DANGER BUTTON

   The one colour in the interface, spent on the one button that ends
   something. It closes in rust rather than in bone, and stays rust while it is
   held: a button that changes hue under the finger reads as a different
   button.
   ========================================================================== */

/* Marked before it is touched, the same way the confirm is. A button that ends
   something should be findable without pointing at every button to see which
   one it was. */

.button--danger {
    border-left-color: var(--danger);
    border-bottom-color: var(--danger);
}


.unity-button.button--danger:hover:enabled {
    color: var(--danger);

    border-left-color: var(--danger);
    border-right-color: var(--danger);
    border-top-color: var(--danger);
    border-bottom-color: var(--danger);
}


.unity-button.button--danger:active:enabled {
    color: var(--danger-pressed);

    border-left-color: var(--danger-pressed);
    border-right-color: var(--danger-pressed);
    border-top-color: var(--danger-pressed);
    border-bottom-color: var(--danger-pressed);
}
