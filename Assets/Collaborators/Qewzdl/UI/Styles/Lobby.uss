/* ==========================================================================
   ROSTER

   The list of who is in the room, and the two things the lobby needs that a
   settings page does not: a row that is a person rather than a setting, and a
   field whose value is a sentence rather than a control.

   A lobby is the one screen the player sits on while waiting, so it is also
   the one screen where things arrive and leave underneath them. Everything
   here is built so that a player joining moves nothing that was already being
   read.
   ========================================================================== */

/* ==========================================================================
   HEADER
   ========================================================================== */

.roster__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}


.roster__summary {
    flex-direction: row;
    align-items: flex-end;
}


/* Readiness is the host's next decision, player count is room capacity. They
   belong together in the header, but readiness stays quieter until everybody
   is ready and the remaining blocker disappears. */

.roster__ready-count {
    color: var(--text-dim);
    font-size: var(--font-size-xs);

    letter-spacing: var(--tracking-wide);

    margin-right: var(--space-s);
    margin-bottom: 2px;

    -unity-text-align: lower-right;
}


.roster__ready-count--complete {
    color: var(--accent);
}


/* The section label carries a top margin for the gap it needs when it follows
   content. Directly under the title it has that gap already. */

.section--flush {
    margin-top: 0;
}


/* ==========================================================================
   LIST
   ========================================================================== */

/* Rows grow inside the lobby's scrollable content. The action block is outside
   that viewport, so joining players add information without moving Ready,
   Start or Leave underneath somebody's pointer. */

.roster {
    border-top-width: var(--border);
    border-top-color: var(--line);

    margin-top: var(--space-xs);
    margin-bottom: var(--space-l);
}


/* The mark for your own row is carried by every row, transparent on the ones
   that are not yours, so nothing shifts sideways when the list is rebuilt and
   somebody else takes the place above you. */

.roster__row {
    flex-direction: row;
    align-items: center;

    /* Sized against the column's budget rather than against nothing. Four rows
       at the old height were a fifth of every pixel the screen has. */
    height: 46px;

    flex-shrink: 0;

    border-left-width: var(--border-strong);
    border-left-color: var(--transparent);

    border-bottom-width: var(--border);
    border-bottom-color: var(--line);

    padding-left: var(--space-s);
    padding-right: var(--space-s);
}


.roster__name {
    flex-grow: 1;

    color: var(--text);
    font-size: var(--font-size-s);

    overflow: hidden;

    -unity-text-align: middle-left;
}


.roster__badges {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;

    margin-left: var(--space-m);
}


/* Which of these four answers to you. Every other line on this screen is about
   your own state - whether you are ready, whether you may start - and the list
   was the one place that never said which row that was. */

.roster__row--you {
    border-left-color: var(--text-dim);
}


.roster__row--you .roster__name {
    color: var(--accent);
}


/* Two states told apart by colour rather than by reading them: waiting on
   somebody is the whole content of this screen, and the host scanning the
   list wants the count, not the words. */

.roster__status {
    color: var(--text-dim);
    font-size: var(--font-size-xs);

    letter-spacing: var(--tracking-wide);

    margin-left: var(--space-s);

    -unity-text-align: middle-right;
}


.roster__status--ready {
    color: var(--accent);
}


/* The host's own mark. Not an achievement and not a state anybody is waiting
   on, so it stays the quietest thing in the row. */

.roster__role {
    color: var(--text-dim);
    font-size: var(--font-size-xs);

    letter-spacing: var(--tracking-wide);

    border-right-width: var(--border);
    border-right-color: var(--line);

    padding-right: var(--space-s);

    -unity-text-align: middle-right;
}


/* Small, and only on other people's rows. A control that removes somebody for
   the rest of the session should be reachable without being in the way. */

/* Framed like every other button in a panel, because it is a thing to press
   rather than a place to go - but sized to sit inside a row, not to be one. */

.roster__kick {
    width: 96px;

    font-size: var(--font-size-xs);

    -unity-text-align: middle-center;

    margin-top: 0;
    margin-bottom: 0;
    margin-left: var(--space-m);

    padding-top: var(--space-xs);
    padding-bottom: var(--space-xs);
    padding-left: var(--space-s);
    padding-right: var(--space-s);
}


/* A room with nobody in it is a room that has not answered yet. Said in words,
   because an empty bordered box says nothing at all. */

.roster__empty {
    flex-grow: 1;

    color: var(--text-dim);
    font-size: var(--font-size-s);

    -unity-text-align: middle-center;
}


/* ==========================================================================
   FIELDS THAT ARE NOT CONTROLS
   ========================================================================== */

/* Whether the door is open is everybody's business and only the host's to
   change, so the state is a sentence in the control column and the button
   that moves it stands next to it - present for one player, absent for the
   rest, and the sentence reads the same either way. */

.field__control--text {
    color: var(--text-dim);
    font-size: var(--font-size-s);

    /* One line. The control column is a fixed width and a wrap here would
       make this row taller than the one above it, which reads as the two
       settings not belonging to the same list. */
    white-space: nowrap;

    -unity-text-align: middle-left;
}


/* The line under a setting, set in the control column rather than under the
   label: it explains the thing on the right, and starting it on the left
   would make it look like a second label. */

.hint--field {
    margin-left: var(--label-width);
    margin-bottom: var(--space-m);

    -unity-text-align: middle-left;
}


/* ==========================================================================
   THE COLUMN

   The lobby stands beside the room rather than over it. It used to be a panel
   in the middle of a black screen, which is the arrangement for a screen with
   nothing behind it - and this one is meant to have the players standing in
   it.

   So it is a column: standing on one edge with the rest of the frame left to
   the camera. It took that shape from the main menu, which has since stopped
   being a column at all - the menu is placed on its picture now, and what it
   handed over is the only rail in the game.
   ========================================================================== */

/* There are no form rows in this column any more. The three settings it used
   to carry - difficulty, the invite address, the door - are a dialog now,
   because the column has 675 pixels on a sixteen-by-nine screen and the roster
   alone is most of what is left after the title and the actions.

   The rules that made a form row stack into a narrow place went with them.
   They were good, and they were holding up content that is no longer here; a
   settings page is wide, and this one is again. */

/* The list takes exactly the room its rows need. Overflow belongs to the
   surrounding ScrollView rather than to this element. */

.panel--rail .roster {
    margin-bottom: var(--space-m);
}


/* The roster is allowed to shrink, and then to scroll. The action block stays
   visible, so a room configured above four players, or a screen wider than
   sixteen by nine - which is a shorter screen, the panel scales to the width -
   never hides Ready, Start or Leave below the frame.

   Kept as a safety net rather than as the plan. Everything fits without it at
   the shapes anybody plays at; what it prevents is the one where content goes
   off the bottom with no way to reach it. */

.lobby__content {
    min-height: 96px;

    /* Takes the room its rows need and no more. It used to claim the leftover
       as well, which was invisible while the column was only ever as tall as
       its contents - there was no leftover. Against a column that now runs the
       full height it would put an empty scroll area between the last player and
       the actions, and the roster would end in a hairline followed by nothing.

       The empty space belongs to .rail__gap instead, which is the class written
       for it: the roster sits under the title, the actions sit on the floor, and
       what is between them is the composition rather than a gap inside a list.

       It still shrinks, so a screen too short for all of this scrolls rather
       than losing the bottom of the room. */
    flex-grow: 0;
    flex-shrink: 1;

    /* No gap of its own under the list. The action block already carries a rule
       and a --space-l above itself, the same one a dialog's footer has, and a
       margin here was a second gap stacked on the first. */
    margin-bottom: 0;
}


.lobby__content > .unity-scroll-view__content-and-vertical-scroll-container,
.lobby__content .unity-scroll-view__content-viewport {
    flex-grow: 1;
}


.lobby__content .unity-scroll-view__content-container {
    padding-right: var(--space-s);
}


/* An address is read out loud down a voice call, one character at a time, and
   the whole point of it is that the person on the other end types back exactly
   what was said. Set in the fixed-width face so a one is not an l, spaced so
   the digits can be counted, and left in the full text colour rather than the
   dim one - it is the only value on this screen anybody has to transcribe. */

.field__control--code {
    color: var(--text);
    font-size: var(--font-size-s);

    letter-spacing: var(--tracking-wide);

    white-space: nowrap;

    -unity-text-align: middle-left;
}


/* The address stays readable while copy feedback changes beside it. Replacing
   the value with "copied" made confirmation clear but forced the player to
   wait before checking or reading the address again. */

/* --------------------------------------------------------------------------
   It is a Button because it has to be pressed, and it is the only one in the
   game that is not an action. It stands in the control column, it holds a
   value, and what a player does with it is read it - the pressing is a
   shortcut for selecting the text by hand.

   So it wears the input's clothes rather than the button's: a surface, a
   hairline, one step brighter under the pointer. The button's own answer is to
   invert, which is right for a word that is a verb and wrong here twice over.
   Loud, first - a bone slab appearing in the middle of a form to say nothing
   has happened yet. And blind: the address is a Label carrying
   .field__control--code, which sets its own colour and so ignores the ink the
   button hands down to its children. The value stayed bone while the fill
   became bone, and the one string on this screen anybody has to transcribe
   disappeared exactly while it was being pointed at.

   Written with the field rather than with the button for the usual reason: the
   control column decides how a control in it looks.
   -------------------------------------------------------------------------- */

.address-copy {
    flex-direction: row;
    align-items: center;

    /* The one control on the screen that is sized by its content rather than
       by the column. An address is set nowrap in a fixed-width face with the
       digits spaced apart, and at the control column's own width a long one
       ran out of room to be read in - which is the only thing this control is
       for. It takes the rest of the row instead. */
    width: auto;

    flex-grow: 1;

    min-height: 46px;

    background-color: var(--surface);

    border-color: var(--line);

    margin-top: 0;
    margin-bottom: 0;

    padding-left: var(--space-s);
    padding-right: var(--space-s);
}


/* One step up on both channels, the way every other field in the column
   answers a pointer. */

.unity-button.address-copy:hover:enabled {
    background-color: var(--surface-hover);

    border-color: var(--line-strong);
}


/* Under the keyboard, and under the finger: the accent outline, which is what
   the text field wears while it has the caret. The same sentence in both
   places - this control is the one being addressed - and here it is also the
   press, because a copy is over before there is time to show anything else.

   What actually confirms the copy is the icon swapping and the tooltip
   changing, which the screen does for itself. */

.unity-button.address-copy:focus:enabled,
.unity-button.address-copy:active:enabled {
    background-color: var(--surface-hover);

    border-color: var(--accent);
}


/* There is no address until the room has one, and until then this is a box
   with nothing in it rather than a button that has stopped working. Keeps its
   surface for that reason - a control that empties out reads as missing. */

.unity-button.address-copy:disabled {
    background-color: var(--surface);

    border-color: var(--text-disabled);
}


.address-copy__value {
    flex-grow: 1;

    padding-left: 0;
    padding-right: var(--space-m);
}


.address-copy__icon {
    width: 22px;
    height: 22px;
    min-width: 22px;
    min-height: 22px;
    max-width: 22px;
    max-height: 22px;

    flex-basis: 22px;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: center;

    /* Tinted rather than left at whatever the texture is, so the glyph reads
       as part of the label instead of as a picture sitting next to it.

       One value covers every state: the surface under it moves a step and
       stays dark, so a tint readable at rest is readable pressed. */
    --unity-image-tint-color: var(--text);
}
