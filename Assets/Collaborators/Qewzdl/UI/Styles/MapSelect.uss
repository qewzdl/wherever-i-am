/* ==========================================================================
   MAP SCREEN

   A screen of its own, not a dialog: while it is up the menu and the masthead
   step aside and the picture behind them is all that is left of the main menu.
   One map to a page - a tall picture, its name and what it is - with the pages
   turned from the two edges of the frame, and what to do with the map in the
   bottom corner, where the menu keeps its own words.

   The picture is 1 wide by 2.3 high - the numbers below are that ratio, not a
   guess at a nice size - and is cropped rather than squashed to fill it.
   ========================================================================== */

.map-screen {
    display: none;

    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    align-items: center;
    justify-content: center;

    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--motion-screen);
    transition-timing-function: var(--ease-standard);
}

.map-screen--open {
    opacity: 1;
}


/* --------------------------------------------------------------------------
   THE PAGE
   -------------------------------------------------------------------------- */

.map-screen__page {
    flex-direction: row;
    /* The name starts level with the top of the picture. */
    align-items: flex-start;

    /* Clear of the arrows on both edges. */
    margin-left: 140px;
    margin-right: 140px;
}

.map-screen__preview {
    width: 260px;
    height: 598px;
    flex-shrink: 0;

    background-color: var(--surface);
    border-width: var(--border);
    border-color: var(--line);

    -unity-background-scale-mode: scale-and-crop;

    justify-content: flex-end;
    align-items: center;
}

/* A map nobody has drawn a picture for yet is still a page, not a hole: the
   frame stays and says so. */
.map-screen__no-preview {
    display: none;
    color: var(--text-disabled);
    font-size: var(--font-size-xs);
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-l);
}

.map-screen__preview--empty .map-screen__no-preview {
    display: flex;
}

/* A locked map is shown, dimmed, so the road ahead can be seen before it can
   be walked. */
.map-screen__preview--locked {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.3);
}

.map-screen__lock {
    display: none;
    color: var(--text);
    font-size: var(--font-size-s);
    letter-spacing: var(--tracking-wider);
    margin-bottom: var(--space-l);
}

.map-screen__preview--locked .map-screen__lock {
    display: flex;
}

.map-screen__text {
    width: 560px;
    flex-shrink: 1;
    margin-left: var(--space-xl);
}

.map-screen__name {
    -unity-text-align: upper-left;
    margin-bottom: var(--space-m);

    /* The line is taller than the letters: pulled up by the difference so
       the tops of the capitals, not the top of the line, sit level with the
       top of the picture. */
    margin-top: -17px;
}

.map-screen__description {
    color: var(--text-dim);
    font-size: var(--font-size-m);
    white-space: normal;
    -unity-text-align: upper-left;

    /* The space before the hint belongs to the description, so it goes when
       the description does. */
    margin-bottom: var(--space-l);
}

.map-screen__hint {
    -unity-text-align: upper-left;
}


/* --------------------------------------------------------------------------
   TURNING THE PAGE

   On the edges of the frame, the whole height of it, the way a page is
   turned from its edge rather than from a row of buttons under it. Each
   arrow is a picture - UI/Images/Icons/icon-arrow-left.png and
   icon-arrow-right.png - small in the middle of its strip, and
   nothing else: no frame, no fill, and nothing that changes when the pointer
   is on it.

   There is no arrow where there is no page to turn to: the first page has
   no left arrow and the last no right one.
   -------------------------------------------------------------------------- */

/* Every state spelled out, and on .unity-button too, so the theme's own
   button looks (a fill or a frame on hover, focus and press) never win. */
.unity-button.map-screen__arrow,
.unity-button.map-screen__arrow:hover,
.unity-button.map-screen__arrow:focus,
.unity-button.map-screen__arrow:active {
    position: absolute;
    top: 0;
    bottom: 0;

    width: 120px;

    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: var(--transparent);

    /* The icon keeps its own size in the middle of the strip, however wide
       the strip is. */
    background-size: 40px auto;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;

    /* Dimmed at rest; lit and leaning the way it turns under the pointer. */
    -unity-background-image-tint-color: rgb(150, 150, 150);

    transition-property: translate, -unity-background-image-tint-color;
    transition-duration: var(--motion-normal), var(--motion-normal);
    transition-timing-function: var(--ease-standard), var(--ease-standard);
}

.map-screen__arrow--previous {
    left: 0;
    background-image: url("../Images/Icons/icon-arrow-left.png");
}

.map-screen__arrow--next {
    right: 0;
    background-image: url("../Images/Icons/icon-arrow-right.png");
}

.unity-button.map-screen__arrow:hover {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.unity-button.map-screen__arrow--previous:hover {
    translate: -6px 0;
}

.unity-button.map-screen__arrow--next:hover {
    translate: 6px 0;
}

.unity-button.map-screen__arrow--previous:hover:active {
    translate: -12px 0;
}

.unity-button.map-screen__arrow--next:hover:active {
    translate: 12px 0;
}


/* --------------------------------------------------------------------------
   THE PAGE TURNING

   The page leaves the way the arrow points and fades as it goes; the next
   one is put on the far side with no transition at all and slides in from
   there (MainMenuDocument.TurnMapPage adds and takes away these). Leaving is
   quick and accelerates, arriving settles - the page is out of the way
   before the new one is looked at. Motion tokens throughout, and with
   Reduced motion the code swaps the page without any of it.
   -------------------------------------------------------------------------- */

.map-screen__page {
    transition-property: translate, opacity;
    transition-duration: var(--motion-screen), var(--motion-screen);
    transition-timing-function: var(--ease-standard), var(--ease-standard);
}

.map-screen__page--leaving-next,
.map-screen__page--leaving-previous {
    opacity: 0;

    transition-duration: var(--motion-normal), var(--motion-normal);
    transition-timing-function: ease-in-cubic, ease-in-cubic;
}

.map-screen__page--leaving-next {
    translate: -48px 0;
}

.map-screen__page--leaving-previous {
    translate: 48px 0;
}

.map-screen__page--arriving-next,
.map-screen__page--arriving-previous {
    opacity: 0;
    transition-duration: 0s, 0s;
}

.map-screen__page--arriving-next {
    translate: 48px 0;
}

.map-screen__page--arriving-previous {
    translate: -48px 0;
}


/* --------------------------------------------------------------------------
   WHERE YOU ARE

   One dot a map, in the order they are played, under the page: the one on
   screen drawn long and bright, a map not yet opened drawn as a ring. It
   stays still while the page turns, so it is the thing that says which way
   you went.
   -------------------------------------------------------------------------- */

.map-screen__dots {
    flex-direction: row;
    justify-content: center;
    align-items: center;

    margin-top: var(--space-xl);
}

.map-screen__dot {
    width: 8px;
    height: 8px;

    margin-left: 4px;
    margin-right: 4px;

    border-radius: 4px;
    border-width: 1px;
    border-color: var(--text-dim);
    background-color: var(--text-dim);

    transition-property: width, background-color, border-color;
    transition-duration: var(--motion-screen), var(--motion-normal), var(--motion-normal);
    transition-timing-function: var(--ease-standard), var(--ease-standard), var(--ease-standard);
}

.map-screen__dot--locked {
    background-color: var(--transparent);
}

.map-screen__dot--current {
    width: 24px;

    border-color: var(--accent);
    background-color: var(--accent);
}

.map-screen__dot--current.map-screen__dot--locked {
    background-color: var(--transparent);
}


/* --------------------------------------------------------------------------
   ARRIVING

   When the screen opens the picture rises into place, the words follow it
   and the dots come last - the order they are read in. The delays are fixed
   and small; with Reduced motion there is nothing left to wait for but them.
   -------------------------------------------------------------------------- */

.map-screen__preview,
.map-screen__text,
.map-screen__dots {
    opacity: 0;
    translate: 0 24px;

    transition-property: opacity, translate;
    transition-duration: var(--motion-screen), var(--motion-screen);
    transition-timing-function: var(--ease-standard), var(--ease-entrance);
}

.map-screen--open .map-screen__preview,
.map-screen--open .map-screen__text,
.map-screen--open .map-screen__dots {
    opacity: 1;
    translate: 0 0;
}

.map-screen--open .map-screen__text {
    transition-delay: 0.06s, 0.06s;
}

.map-screen--open .map-screen__dots {
    transition-delay: 0.12s, 0.12s;
}


/* --------------------------------------------------------------------------
   WHAT TO DO WITH IT
   -------------------------------------------------------------------------- */

.map-screen__footer {
    position: absolute;
    right: var(--space-xl);
    bottom: var(--space-xl);

    flex-direction: row;
    align-items: center;
}

.map-screen__footer .button {
    min-width: 160px;
    margin-left: var(--space-s);
    -unity-text-align: middle-center;
}


/* ==========================================================================
   CHOICE SCREENS

   Play opens one - Singleplayer or Multiplayer - and Multiplayer opens the
   next - create a lobby or join one. Two large buttons side by side, each a
   picture of what it does with its name under it, and Back in the bottom
   corner where the other screens keep theirs.
   The pictures are UI/Images/lobby/image-lobby-create.png and
   image-lobby-join.png, square, and fitted rather than cropped.
   ========================================================================== */

.choice-screen {
    display: none;

    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    align-items: center;
    justify-content: center;

    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--motion-screen);
    transition-timing-function: var(--ease-standard);
}

.choice-screen--open {
    opacity: 1;
}

.choice-screen__choices {
    flex-direction: row;
}

/* No frame and no fill in any state - the theme's button looks are spelled
   out of every one of them, on .unity-button so they win. */
.unity-button.picture-choice,
.unity-button.picture-choice:hover,
.unity-button.picture-choice:focus,
.unity-button.picture-choice:active {
    flex-direction: column;
    align-items: center;

    margin-left: var(--space-l);
    margin-right: var(--space-l);
    padding: 0;

    border-width: 0;
    background-color: var(--transparent);
}


/* --------------------------------------------------------------------------
   UNDER THE POINTER

   A transition is read off the state being arrived at, so the way up and the
   way down are written separately. Up is quick and overshoots a touch, the
   way something light answers a hand; down settles without one, because a
   choice that bounced every time the pointer left it would never be still.
   Pressed, it dips back towards the surface. All of it on the motion
   tokens, so Reduced motion turns it into a plain change of state.
   -------------------------------------------------------------------------- */

.unity-button.picture-choice {
    transition-property: translate, scale;
    transition-duration: var(--motion-screen), var(--motion-screen);
    transition-timing-function: var(--ease-standard), var(--ease-standard);
}

.unity-button.picture-choice:hover {
    translate: 0 -8px;
    scale: 1.04 1.04;

    transition-duration: var(--motion-screen), var(--motion-screen);
    transition-timing-function: var(--ease-entrance), var(--ease-entrance);
}

.unity-button.picture-choice:hover:active {
    translate: 0 -3px;
    scale: 1.01 1.01;

    transition-duration: var(--motion-fast), var(--motion-fast);
    transition-timing-function: var(--ease-standard), var(--ease-standard);
}

/* The picture is dimmed at rest and comes up to full under the pointer -
   white drawn on black, so this reads as the picture being lit rather than
   a highlight laid over it. */
.picture-choice__picture {
    width: 360px;
    height: 360px;

    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(190, 190, 190);
}

.unity-button.picture-choice:hover .picture-choice__picture {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.picture-choice__picture--create {
    background-image: url("../Images/lobby/image-lobby-create.png");
}

.picture-choice__picture--join {
    background-image: url("../Images/lobby/image-lobby-join.png");
}

.picture-choice__picture--singleplayer {
    background-image: url("../Images/image-menu-singleplayer.png");
}

.picture-choice__picture--multiplayer {
    background-image: url("../Images/image-menu-multiplayer.png");
}

.picture-choice__caption {
    margin-top: var(--space-m);

    color: var(--text-dim);
    font-size: var(--font-size-m);
    letter-spacing: var(--tracking-wide);

    -unity-text-align: middle-center;
}

/* Focus is said by the name, not by the lift, and only focus the keyboard or
   a pad put there (--focused, set from code). A click focuses the button it
   lands on, and coming back from the maps focuses the one that led there, so
   anything shown for :focus stayed on after the pointer had gone and looked
   like a hover that would not let go. The name, dim at rest, comes up bright
   - under the pointer as well, so the two never disagree. */
.unity-button.picture-choice:hover .picture-choice__caption,
.picture-choice--focused .picture-choice__caption {
    color: var(--accent);
}


/* --------------------------------------------------------------------------
   ARRIVING

   When the screen opens the pictures rise into place and the names follow
   them, Create a beat before Join, so the two read as two things to choose
   between rather than one block appearing. It is the picture and the name
   that move, not the button: the button's own transitions belong to the
   pointer, and a delay written there would hold back every hover as well.
   The delays are fixed rather than tokens, and small - with Reduced motion
   there is nothing left to wait for but the beat itself.
   -------------------------------------------------------------------------- */

.picture-choice__picture {
    transition-property: -unity-background-image-tint-color;
    transition-duration: var(--motion-normal);
    transition-timing-function: var(--ease-standard);
}

.picture-choice__caption {
    transition-property: color;
    transition-duration: var(--motion-normal);
    transition-timing-function: var(--ease-standard);
}

.choice-screen .picture-choice__picture,
.choice-screen .picture-choice__caption {
    opacity: 0;
    translate: 0 24px;

    transition-property: opacity, translate, -unity-background-image-tint-color, color;
    transition-duration: var(--motion-screen), var(--motion-screen), var(--motion-normal), var(--motion-normal);
    transition-timing-function: var(--ease-standard), var(--ease-entrance), var(--ease-standard), var(--ease-standard);
}

.choice-screen--open .picture-choice__picture,
.choice-screen--open .picture-choice__caption {
    opacity: 1;
    translate: 0 0;
}

.choice-screen--open .picture-choice__caption {
    transition-delay: 0.06s, 0.06s, 0s, 0s;
}

.choice-screen--open .picture-choice--later .picture-choice__picture {
    transition-delay: 0.08s, 0.08s, 0s, 0s;
}

.choice-screen--open .picture-choice--later .picture-choice__caption {
    transition-delay: 0.14s, 0.14s, 0s, 0s;
}

.choice-screen__footer {
    position: absolute;
    right: var(--space-xl);
    bottom: var(--space-xl);

    flex-direction: row;
}

.choice-screen__footer .button {
    min-width: 160px;
    -unity-text-align: middle-center;
}
