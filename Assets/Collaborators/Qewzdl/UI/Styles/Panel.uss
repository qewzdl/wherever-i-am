/* ==========================================================================
   PANEL
   ========================================================================== */

/* ==========================================================================
   PANEL
   ========================================================================== */

.panel {
    background-color: var(--surface);

    border-color: var(--line);

    border-width: var(--border);

    border-radius: var(--radius);

    padding-left: var(--space-l);
    padding-right: var(--space-l);
    padding-top: var(--space-l);
    padding-bottom: var(--space-l);

    scale: 0.97 0.97;
    translate: 0 10px;

    /* Two properties rather than one. A panel that only grows looks like a
       zoom; a panel that rises while it grows looks like it was put there. */
    transition-property:
        scale,
        translate;

    transition-duration: var(--motion-screen);
    transition-timing-function: var(--ease-entrance);
}


.screen--open .panel {
    scale: 1 1;
    translate: 0 0;
}


.panel--narrow {
    width: 320px;
}


.panel--dialog {
    width: 440px;
}


/* Network work is described as a changing stage, a stable target and a clock.
   Keeping those as separate lines lets the stage change without making the
   address or elapsed time jump sideways with it. */

.connection-status__step {
    margin-top: 0;
    margin-bottom: var(--space-s);

    -unity-text-align: middle-center;
}


.connection-status__detail {
    min-height: 20px;

    margin-top: var(--space-m);
    margin-bottom: 0;
}


.connection-status__elapsed {
    margin-top: var(--space-s);
    margin-bottom: 0;
}


/* A panel inside an overlay opens with the overlay, not with the screen
   underneath it. Without this it is already at rest by the time anyone asks
   for it - the screen opened minutes ago and the panel finished rising with
   it, so the dialog would fade in fully assembled.

   Said of any panel in an overlay rather than of .panel--dialog, which is a
   width. Tying the entrance to one width meant a wider dialog had to wear both
   classes and hope the stylesheet resolved them in the right order.

   Written after the screen rule on purpose: same specificity, later wins. */

.overlay .panel {
    scale: 0.97 0.97;
    translate: 0 10px;

    transition-duration: var(--motion-normal);
}


.overlay--open .panel {
    scale: 1 1;
    translate: 0 0;
}


/* A panel that runs the height of the screen down one edge. Translucent
   rather than solid, because the point of standing beside the scene is to
   let it through; and it slides in from its own edge instead of zooming,
   which is the movement a thing anchored to a side would make.

   Text inside it reads from the left. Centring works in a box in the middle
   of the screen and looks accidental in a column against an edge. */

.panel--rail {
    width: 460px;

    /* Said as a height, because align-self does not mean this here. A screen is
       a column, so its cross axis is the horizontal one - align-self: stretch
       was reaching sideways, where the fixed width already had an answer, and
       the panel took the height of whatever was in it and sat in the middle of
       the frame.

       It looked right for as long as every rail overflowed: a column too tall
       for the screen shrinks to it, which is the same shape by accident. The
       moment the lobby's contents fit, the wall became a box floating off both
       ends, and the main menu had been quietly holding its name and its buttons
       in the middle rather than at the bottom, which is what .rail__gap is for.

       Everything else in this file that talks about a column running the height
       of the screen was describing an intention. This is the line that makes it
       true. */
    height: 100%;

    justify-content: flex-start;

    /* Wide at the sides, and the panel's own measure at the ends.

       The sides are what make a column read as a page rather than as a strip.
       The ends wanted the same once, back when a rail held a name and four
       words; a rail holding a roster cannot afford it. There are 675 logical
       pixels of height on a sixteen-by-nine screen - the panel scales to the
       width of the window, so the aspect ratio fixes the height and no monitor
       buys more - and twenty of the forty this would cost at each end come
       straight out of the list. */
    padding-top: var(--space-l);
    padding-bottom: var(--space-l);
    padding-left: var(--space-xl);
    padding-right: var(--space-xl);

    /* A wall, not a veil. This used to be --veil with .panel--solid painting
       over it, back when the main menu wore this class too and wanted the
       backdrop to come through. The main menu is placed on the picture now and
       has no column at all, so the only rail left is the lobby's - and the
       lobby's stands over a room with people lit in it, where a tenth coming
       through is not depth but a bright shape crossing behind the text, moving
       whenever somebody readies up. A modifier that is applied every time it is
       applicable is not a choice, so the choice is gone and the value is here. */
    background-color: var(--veil-solid);

    border-width: 0;

    border-radius: 0;

    scale: 1 1;
    translate: -16px 0;

    transition-property: translate;
    transition-duration: var(--motion-screen);
    transition-timing-function: var(--ease-entrance);
}


.screen--open .panel--rail {
    translate: 0 0;
}




/* Who you are stays with the title at the top; what you can do goes to the
   bottom, where the hand already is. The gap between them is not a size but
   whatever is left over - the menu keeps its shape at any window height, and
   the empty middle is the point rather than an accident. */

/* Text in a column reads from the left. Centring works in a box in the middle
   of the screen and looks accidental against an edge. */

.panel--rail .hint {
    -unity-text-align: middle-left;
}


/* Where the column's empty space goes. One element claims all of it, and what
   sits above that element stays at the top while everything below it is held
   at the bottom - so the menu keeps its shape at any window height and the gap
   is the composition rather than a leftover.

   Said by one element rather than by the rule for a kind of element. It used
   to be attached to .hint, which held while the main menu was a column with one
   hint in it, and stopped holding the moment a second column existed. The main
   menu is not a column any more and the lobby is the only thing here, but the
   reasoning survives it: a rule about a kind of element cannot know which one of
   them is meant to hold the empty space.

   Two of these in one column would split the space and put everything back in
   the middle, so a column gets one. */

.rail__gap {
    margin-top: auto;
}


.panel--rail .stack {
    /* A line above the actions, the same one dialogs have over their footers.
       Who you are is one thing and what you can do is another, and the gap
       alone was not saying so. */
    border-top-width: var(--border);
    border-top-color: var(--line);

    padding-top: var(--space-l);
}


/* --------------------------------------------------------------------------
   MENU ITEMS

   The one place the frame comes off. In a panel a button is a thing to press
   and looks like one; in a column against the edge of the screen it is a place
   to go, and four boxes stacked on top of each other read as a form to be
   filled in rather than as a list to be chosen from.

   What is left is the word, lighting the same way it lights everywhere else -
   so this is one control with its edge removed rather than a second control,
   which is what the two styles here used to be.

   Given room, as well. A row in a dialog is sized to sit beside two others; a
   list wants height between its entries more than it wants anything.
   -------------------------------------------------------------------------- */

.panel--rail .stack .button {
    /* Dim, said here because the framed button stopped being. These are words
       rather than boxes and the word is the only channel they have: dim at
       rest, accent under the pointer, with confirm resting between the two. A
       column of four entries all already bone would leave confirm nowhere to
       stand and the pointer nothing to answer with. */
    color: var(--text-dim);

    border-width: 0;

    padding-top: var(--space-m);
    padding-bottom: var(--space-m);

    /* No indent either. The word lines up with everything else in the column,
       which is the whole point of taking the box off it. */
    padding-left: 0;
    padding-right: 0;

    -unity-text-align: middle-left;
}


/* And with the frame goes the fill. A button in a panel inverts under the
   pointer, because it has an edge for the colour to come from; an entry in
   this column has none, so a fill would not be the frame flooding inwards -
   it would be a bone bar appearing out of nothing, four of them taking turns
   as the pointer runs down the list.

   So here the word lights, the way it did everywhere before the pointer
   learned to fill things. Stated with the container rather than on the button,
   for the same reason the frame is. */

.panel--rail .stack .button:hover:enabled {
    color: var(--accent);

    background-color: var(--transparent);
}


.panel--rail .stack .button:active:enabled {
    color: var(--accent-pressed);

    background-color: var(--transparent);
}


/* The entry the column exists for rests one step up rather than at the top.

   In a panel confirm is the brightest thing in the footer and the pointer
   answers by filling it, so resting at the accent costs nothing. Here the
   pointer answers on the same channel confirm was using, and a button already
   at the top of a ladder has nowhere to go: Create lobby and Start were lit at
   rest, lit under the pointer, and lit while held - the whole column responded
   to a pointer except the one entry anybody was going to press.

   So it starts at the text step. Still plainly brighter than the three dim
   words beside it, still the thing that changes when a lobby fills up and
   Start becomes available, and now with two steps left above it.

   Focus lands on that same step and so does not show on this one button. The
   channel has three places on it and confirm is standing on the middle one;
   buying focus back means giving the column a mark, and a mark on a frameless
   entry either shifts the word off the column's left edge or has to be carried
   by every entry to avoid it. Not worth it for a menu that is four items long
   and answers the pointer correctly. */

.panel--rail .stack .button--confirm {
    color: var(--text);
}


.panel--wide {
    width: 720px;
}


