/* ==========================================================================
   PANEL
   ========================================================================== */

/* ==========================================================================
   PANEL
   ========================================================================== */

.panel {
    background-color: var(--surface);

    border-left-color: var(--line);
    border-right-color: var(--line);
    border-top-color: var(--line);
    border-bottom-color: var(--line);

    border-left-width: var(--border);
    border-right-width: var(--border);
    border-top-width: var(--border);
    border-bottom-width: var(--border);

    border-radius: var(--radius);

    padding-left: var(--space-l);
    padding-right: var(--space-l);
    padding-top: var(--space-l);
    padding-bottom: var(--space-l);

    scale: 0.97 0.97;
    translate: 0 10px;

    /* Two properties rather than one. A panel that only grows looks like a
       zoom; a panel that rises while it grows looks like it was put there. */
    transition-property:
        scale,
        translate;

    transition-duration: var(--motion-screen);
    transition-timing-function: var(--ease-entrance);
}


.screen--open .panel {
    scale: 1 1;
    translate: 0 0;
}


.panel--narrow {
    width: 320px;
}


.panel--dialog {
    width: 440px;
}


/* A dialog inside an overlay opens with the overlay, not with the screen
   underneath it. Without this it is already at rest by the time anyone asks
   for it - the screen opened minutes ago and the panel finished rising with
   it, so the dialog would fade in fully assembled.

   Written after the screen rule on purpose: same specificity, later wins. */

.overlay .panel--dialog {
    scale: 0.97 0.97;
    translate: 0 10px;

    transition-duration: var(--motion-normal);
}


.overlay--open .panel--dialog {
    scale: 1 1;
    translate: 0 0;
}


/* A panel that runs the height of the screen down one edge. Translucent
   rather than solid, because the point of standing beside the scene is to
   let it through; and it slides in from its own edge instead of zooming,
   which is the movement a thing anchored to a side would make.

   Text inside it reads from the left. Centring works in a box in the middle
   of the screen and looks accidental in a column against an edge. */

.panel--rail {
    width: 460px;

    align-self: stretch;
    justify-content: flex-start;

    /* A column that runs the height of the screen needs more room at its ends
       than a dialog does. At the panel's own padding the title sat on the top
       edge and the last button on the bottom one, which is what made it read
       as a strip rather than as a page. */
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
    padding-left: var(--space-xl);
    padding-right: var(--space-xl);

    background-color: var(--veil);

    border-left-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-right-width: 0;

    border-radius: 0;

    scale: 1 1;
    translate: -16px 0;

    transition-property: translate;
    transition-duration: var(--motion-screen);
    transition-timing-function: var(--ease-entrance);
}


.screen--open .panel--rail {
    translate: 0 0;
}




/* Who you are stays with the title at the top; what you can do goes to the
   bottom, where the hand already is. The gap between them is not a size but
   whatever is left over - the menu keeps its shape at any window height, and
   the empty middle is the point rather than an accident. */

/* Everything the column holds now sits at the bottom of it, because the top
   belongs to the name: the masthead is placed over that corner, and a field
   starting there would be underneath it. The free space is taken once, by the
   first thing in the group - two auto margins would split it and put the
   controls back in the middle. */

.panel--rail .hint {
    margin-top: auto;

    -unity-text-align: middle-left;
}


.panel--rail .stack {
    /* A line above the actions, the same one dialogs have over their footers.
       Who you are is one thing and what you can do is another, and the gap
       alone was not saying so. */
    border-top-width: var(--border);
    border-top-color: var(--line);

    padding-top: var(--space-l);
}


/* --------------------------------------------------------------------------
   ARRIVAL

   The column slides in as one piece, and the things in it follow one after
   another rather than all at once. A menu that assembles itself reads as a
   place being opened; a menu that appears whole reads as a screenshot.

   USS cannot count children, so the order is written into the markup. Ugly
   there, honest here: the alternative is a script that exists only to stagger
   four labels.

   The buttons arrive as one block rather than one by one. A delay in USS
   applies to everything the element transitions, so a stagger class on a
   button would also delay the colour it takes when the pointer reaches it -
   and a menu item that lights up a fifth of a second late feels broken in a
   way no entrance is worth.
   -------------------------------------------------------------------------- */

.rail__item {
    opacity: 0;

    translate: 0 12px;

    transition-property:
        opacity,
        translate;

    transition-duration: var(--motion-screen);
    transition-timing-function: var(--ease-standard);
}


.screen--open .rail__item {
    opacity: 1;

    translate: 0 0;
}


.rail__item--2 {
    transition-delay: 0.04s;
}


.rail__item--3 {
    transition-delay: 0.08s;
}


.rail__item--4 {
    transition-delay: 0.12s;
}


/* --------------------------------------------------------------------------
   MENU ITEMS

   In a dialog a button is a box you press. In a column against the edge of the
   screen it is a place to go, and the boxes get in the way of reading it as a
   list. So the border comes off three sides and stays on the fourth, where it
   does the work: transparent until the pointer arrives, accent under it.

   The bar is always there and only changes colour, so nothing moves sideways
   when it appears. What moves is the item itself, leaning six pixels towards
   the pointer - small enough that nobody would call it an animation, large
   enough that the row under the cursor is never in doubt.
   -------------------------------------------------------------------------- */

.panel--rail .unity-button.button {
    background-color: rgba(0, 0, 0, 0);

    border-left-width: 3px;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;

    border-left-color: rgba(0, 0, 0, 0);

    padding-top: var(--space-m);
    padding-bottom: var(--space-m);
}


/* The one action the screen exists for keeps its bar lit, so the column has a
   place the eye lands before it starts reading. */

.panel--rail .unity-button.button--confirm {
    color: var(--accent);

    border-left-color: var(--line-hover);
}


.panel--rail .unity-button.button:hover:enabled {
    color: var(--accent);

    background-color: rgba(0, 0, 0, 0);

    border-left-color: var(--accent);

    translate: 6px 0;
    scale: 1 1;
}


.panel--rail .unity-button.button:focus:enabled {
    color: var(--text);

    background-color: rgba(0, 0, 0, 0);

    border-left-color: var(--line-hover);
}


.panel--rail .unity-button.button:active:enabled {
    color: var(--accent-pressed);

    background-color: rgba(0, 0, 0, 0);

    border-left-color: var(--accent-pressed);

    translate: 3px 0;
    scale: 1 1;
}


.panel--rail .button {
    padding-left: var(--space-m);

    -unity-text-align: middle-left;
}


.panel--wide {
    width: 720px;
}


