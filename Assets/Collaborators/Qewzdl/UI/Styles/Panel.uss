/* ==========================================================================
   PANEL
   ========================================================================== */

/* ==========================================================================
   PANEL
   ========================================================================== */

.panel {
    background-color: var(--surface);

    border-left-color: var(--line);
    border-right-color: var(--line);
    border-top-color: var(--line);
    border-bottom-color: var(--line);

    border-left-width: var(--border);
    border-right-width: var(--border);
    border-top-width: var(--border);
    border-bottom-width: var(--border);

    border-radius: var(--radius);

    padding-left: var(--space-l);
    padding-right: var(--space-l);
    padding-top: var(--space-l);
    padding-bottom: var(--space-l);

    scale: 0.97 0.97;

    transition-property: scale;
    transition-duration: var(--motion-screen);
    transition-timing-function: var(--ease-standard);
}


.screen--open .panel {
    scale: 1 1;
}


.panel--narrow {
    width: 320px;
}


.panel--dialog {
    width: 440px;
}


/* A panel that runs the height of the screen down one edge. Translucent
   rather than solid, because the point of standing beside the scene is to
   let it through; and it slides in from its own edge instead of zooming,
   which is the movement a thing anchored to a side would make.

   Text inside it reads from the left. Centring works in a box in the middle
   of the screen and looks accidental in a column against an edge. */

.panel--rail {
    width: 420px;

    align-self: stretch;
    justify-content: flex-start;

    background-color: var(--veil);

    border-left-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-right-width: 0;

    border-radius: 0;

    scale: 1 1;
    translate: -16px 0;

    transition-property: translate;
    transition-duration: var(--motion-screen);
    transition-timing-function: var(--ease-standard);
}


.screen--open .panel--rail {
    translate: 0 0;
}


.panel--rail .title,
.panel--rail .hint {
    -unity-text-align: middle-left;
}


/* Who you are stays with the title at the top; what you can do goes to the
   bottom, where the hand already is. The gap between them is not a size but
   whatever is left over - the menu keeps its shape at any window height, and
   the empty middle is the point rather than an accident. */

.panel--rail .stack {
    margin-top: auto;
}


.panel--rail .button {
    padding-left: var(--space-m);

    -unity-text-align: middle-left;
}


.panel--wide {
    width: 720px;
}


