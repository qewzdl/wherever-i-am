/* ==========================================================================
   SLIDER
   ========================================================================== */

/* ==========================================================================
   SLIDER
   ========================================================================== */

.field__control .unity-base-slider__tracker {
    background-color: var(--line);

    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;

    transition-property: background-color;
    transition-duration: var(--motion-normal);
    transition-timing-function: var(--ease-standard);
}


.field__control:hover .unity-base-slider__tracker {
    background-color: var(--line-hover);
}


.field__control .unity-base-slider__dragger {
    background-color: var(--text);

    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;

    border-radius: var(--radius);

    scale: 1 1;

    transition-property:
        background-color,
        scale;

    transition-duration: var(--motion-normal);
    transition-timing-function: var(--ease-standard);
}


.field__control:hover .unity-base-slider__dragger {
    background-color: var(--accent);

    scale: 1.08 1.08;
}


