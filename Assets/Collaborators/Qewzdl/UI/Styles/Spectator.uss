/* ==========================================================================
   SPECTATOR

   What a caught player is told while they watch somebody else play.

   It is the only part of this interface read over a live picture rather than
   over a wall, and read by the one person on the screen with nothing to do: no
   crosshair to aim, no keys that matter except the two that change whose eyes
   these are. So it takes the bottom edge and nothing else.

   A band rather than a card. The first version of this was a box floating a
   little way up from the bottom, centred, with three rows stacked inside it -
   and nothing in this game floats. The lobby is a wall down one edge, the chat
   is a wall in a corner, and both are flush to the frame because a thing that
   reaches the edge of the screen does not need a line to say where it stops.
   Stacked, it also stood three lines tall over a match somebody else was still
   playing. Laid out as one row it is a third of that, and each of the three
   things it says has somewhere obvious to sit: whose eyes on the left, the
   rotation in the middle, what to press on the right.
   ========================================================================== */

.spectate {
    /* Its own panel, so it carries the game's face itself - the same reason
       the chat layer does. */
    -unity-font-definition:
        url("project://database/Assets/Collaborators/Qewzdl/Fonts/Vectipede%20Th%20SDF.asset?fileID=11400000&guid=f62a91bdc6ed1864f8d536b0db2daaff&type=2#Vectipede Th SDF");

    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    justify-content: flex-end;

    /* Away until this player is caught, said here rather than in the first
       frame of code: an element that starts visible and is put away a moment
       later is a flash of empty box at the top of every match. From here on it
       is UiFade that owns this, inline. */
    display: none;
}


/* ==========================================================================
   THE BAND
   ========================================================================== */

.spectate__band {
    flex-direction: row;
    align-items: center;

    /* The veil, which is the role for a layer laid over the picture. This used
       to be a colour written out in full here - the one literal in the whole
       theme - and Tokens.uss says what that means: if a rule needs a colour
       there is no role for, the missing role is the bug. There was a role. */
    background-color: var(--veil);

    /* A rule along the top, which is what this interface puts between what you
       read and what is above it. The band reaches three edges, so those need
       nothing. */
    border-top-width: var(--border);
    border-top-color: var(--line);

    padding-left: var(--space-l);
    padding-right: var(--space-l);
    padding-top: var(--space-m);
    padding-bottom: var(--space-m);

    /* It arrives, like everything else here, and from the edge it is hinged to.
       Reduced motion needs no rule of its own: the duration it zeroes is this
       one, and the open state is the resting state. */
    opacity: 0;
    translate: 0 14px;

    transition-property:
        opacity,
        translate;

    transition-duration: var(--motion-normal);
    transition-timing-function: var(--ease-standard);
}


.spectate--open .spectate__band {
    opacity: 1;
    translate: 0 0;
}


/* ==========================================================================
   WHOSE EYES

   The one thing here worth reading from across the room, so it is the only
   thing set at a heading's size. It keeps its own width rather than sharing:
   a name that grows and shrinks the middle of the band every time the camera
   moves on is a band that never sits still.
   ========================================================================== */

.spectate__watching {
    flex-shrink: 0;

    color: var(--text);
    font-size: var(--font-size-m);

    letter-spacing: var(--tracking-wide);
}


/* Nobody left. Said in the voice a note is written in, because it is the
   absence of a name rather than one. */

.spectate__watching--nobody {
    color: var(--text-dim);
}


/* ==========================================================================
   WHO IS LEFT

   Names, not a number. "3 still alive" tells a spectator how many people are
   in a room they cannot see; the names tell them who, which of them they are
   looking through, and where the next press goes - the same list doing all
   three jobs.
   ========================================================================== */

.spectate__survivors {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;

    justify-content: center;

    padding-left: var(--space-l);
    padding-right: var(--space-l);
}


.spectate__survivor {
    color: var(--text-dim);
    font-size: var(--font-size-xs);

    letter-spacing: var(--tracking-wide);

    margin-left: var(--space-s);
    margin-right: var(--space-s);
}


/* The one being watched, marked the way the lobby marks the row that is you -
   the accent on the name and nothing else moved. */

.spectate__survivor--watched {
    color: var(--accent);
}


/* Where the Next button goes. Three steps of one ladder rather than three
   ideas: the one you are looking through, the one you are a press away from,
   and everybody else.

   The list keeps its own order rather than rotating to put the watched player
   first - a list that reorders itself while you cycle is one nobody can keep
   their place in. It says where the press leads instead of moving to prove it. */

.spectate__survivor--next {
    color: var(--text);
}


/* ==========================================================================
   WHAT TO PRESS

   The half that was missing altogether. A spectator can do exactly two things
   and the screen said nothing about either.
   ========================================================================== */

.spectate__keys {
    flex-shrink: 0;
    flex-direction: row;
}


.spectate__key {
    flex-direction: row;
    align-items: center;

    margin-left: var(--space-m);
}


/* The button, in a box, the way the chat strip draws the key that opens it. */

.spectate__key__button {
    color: var(--text);
    font-size: var(--font-size-xs);

    letter-spacing: var(--tracking-wide);

    border-width: var(--border);
    border-color: var(--line-strong);

    padding-left: var(--space-s);
    padding-right: var(--space-s);

    margin-right: var(--space-s);
}


.spectate__key__name {
    color: var(--text-dim);
    font-size: var(--font-size-xs);

    letter-spacing: var(--tracking-wide);
}
