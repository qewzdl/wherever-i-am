/* ==========================================================================
   TABS
   ========================================================================== */

/* ==========================================================================
   TABS
   ========================================================================== */

.tabs {
    flex-direction: row;

    margin-bottom: var(--space-m);
}


.tab {
    color: var(--text-dim);
    font-size: var(--text-m);

    background-color: rgba(0, 0, 0, 0);

    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;

    /* Wide enough to be a mark rather than an edge, and present on every tab
       so that choosing one moves no text. */
    border-bottom-width: var(--border-strong);

    /* Held where it is. Buttons open their tracking under the pointer; a row
       of four tabs doing that would shove each other sideways, and a tab has
       its own mark to move instead. */
    letter-spacing: var(--tracking-wide);

    border-bottom-color: rgba(0, 0, 0, 0);

    border-radius: 0;

    padding-left: var(--space-m);
    padding-right: var(--space-m);
    padding-top: var(--space-s);
    padding-bottom: var(--space-s);

    margin-right: var(--space-xs);

    transition-property:
        color,
        border-bottom-color;

    transition-duration: var(--motion-normal);
    transition-timing-function: var(--ease-standard);
}


.unity-button.tab:focus:enabled {
    letter-spacing: var(--tracking-wide);

    color: var(--text);

    background-color: rgba(0, 0, 0, 0);

    /* The mark stays where the active tab's is, so focus is read as "this one
       next" rather than as a second selection. */
    border-bottom-color: var(--text-dim);
}


.unity-button.tab:hover:enabled {
    letter-spacing: var(--tracking-wide);

    color: var(--text);

    background-color: rgba(0, 0, 0, 0);

    border-bottom-color: var(--line-hover);
}


.tab--active {
    color: var(--text);

    border-bottom-color: var(--accent);
}


.unity-button.tab--active:focus:enabled {
    letter-spacing: var(--tracking-wide);

    color: var(--text);

    border-bottom-color: var(--accent);
}


.unity-button.tab--active:hover:enabled {
    letter-spacing: var(--tracking-wide);

    color: var(--text);

    border-bottom-color: var(--accent);
}


