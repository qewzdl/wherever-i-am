/* ==========================================================================
   TABS
   ========================================================================== */

/* ==========================================================================
   TABS
   ========================================================================== */

.tabs {
    flex-direction: row;

    /* Onto a second line rather than off the edge. Five tabs fit across a wide
       panel at the type size this interface is drawn at, and the player can now
       change that type size - which is exactly the setting somebody reaches
       this row to find. A tab they cannot see is a tab they cannot press. */
    flex-wrap: wrap;

    margin-bottom: var(--space-m);
}


.tab {
    color: var(--text-dim);
    font-size: var(--font-size-m);

    background-color: var(--transparent);

    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;

    /* Wide enough to be a mark rather than an edge, and present on every tab
       so that choosing one moves no text. */
    border-bottom-width: var(--border-strong);


    border-bottom-color: var(--transparent);

    border-radius: 0;

    padding-left: var(--space-m);
    padding-right: var(--space-m);
    padding-top: var(--space-s);
    padding-bottom: var(--space-s);

    margin-right: var(--space-xs);

    transition-property:
        color,
        border-bottom-color;

    transition-duration: var(--motion-normal);
    transition-timing-function: var(--ease-standard);
}


.unity-button.tab:focus:enabled {
    color: var(--text);

    background-color: var(--transparent);

    /* The mark stays where the active tab's is, so focus is read as "this one
       next" rather than as a second selection. */
    border-bottom-color: var(--text-dim);
}


.unity-button.tab:hover:enabled {
    color: var(--text);

    background-color: var(--transparent);

    border-bottom-color: var(--line-strong);
}


.tab--active {
    color: var(--text);

    border-bottom-color: var(--accent);
}


.unity-button.tab--active:focus:enabled {
    color: var(--text);

    border-bottom-color: var(--accent);
}


.unity-button.tab--active:hover:enabled {
    color: var(--text);

    border-bottom-color: var(--accent);
}


/* ==========================================================================
   THE MARK THAT MOVES

   The chosen tab's mark is one strip, drawn under whichever tab is chosen
   and sliding from the last one to the next, so a change of page is seen
   as a move rather than one line going out and another coming on. Placed
   by SettingsDocument from the tab's own box - which also follows the row
   when it wraps at a large text size - and put there with no transition the
   first time and whenever the row is laid out again.
   ========================================================================== */

.tabs__indicator {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: var(--border-strong);

    background-color: var(--accent);

    transition-property: left, top, width;
    transition-duration: var(--motion-screen), var(--motion-screen), var(--motion-screen);
    transition-timing-function: var(--ease-standard), var(--ease-standard), var(--ease-standard);
}

.tabs__indicator--instant {
    transition-duration: 0s, 0s, 0s;
}

/* The strip is the mark now; the chosen tab keeps the colour of its name. */
.tab--active,
.unity-button.tab--active:focus:enabled,
.unity-button.tab--active:hover:enabled {
    border-bottom-color: var(--transparent);
}

/* A page arrives rather than appears: it fades in, while the strip is still
   on its way. */
.page {
    transition-property: opacity;
    transition-duration: var(--motion-screen);
    transition-timing-function: var(--ease-standard);
}

.page--arriving {
    opacity: 0;
    transition-duration: 0s;
}
