/* ==========================================================================
   TEXT FIELD

   Structure:

   .input.unity-text-field
       └── .unity-base-text-field__input      - the box
               └── TextElement                - what was typed

   Unity draws the box on the inner element and colours it from its own theme
   variables, so both are overridden: the variables for the states Unity paints
   itself, and the properties for everything else.

   The class is `input` rather than a Unity one because the sound bindings
   already listen for it - a field earns its typing sound by being one.
   ========================================================================== */

.input {
    margin-top: 0;
    margin-bottom: var(--space-s);
}


/* A field that gates a network request explains why the action is unavailable
   before the player spends a connection timeout finding out. Kept beside the
   field rather than in the global error overlay because nothing has failed. */

.input__hint {
    min-height: 32px;

    margin-top: 0;
    margin-bottom: var(--space-s);

    -unity-text-align: middle-left;
}


.input__hint--error {
    color: var(--danger);
}


/* --------------------------------------------------------------------------
   UNITY THEME OVERRIDES

   Set on the field and on the box inside it. Unity paints the focus ring from
   these variables on the inner element, and while variables do inherit, the
   ring it draws for a focused field is the one thing in this theme that has
   come back blue every time it was only told once.
   -------------------------------------------------------------------------- */

.input.unity-text-field,
.input.unity-text-field > .unity-base-text-field__input {
    --unity-colors-input_background: var(--surface);
    --unity-colors-input_background-hover: var(--surface-hover);
    --unity-colors-input_border: var(--line);
    --unity-colors-input_border-hover: var(--line-strong);
    --unity-colors-input_border-focus: var(--accent);
    --unity-colors-input_border-accent: var(--accent);

    /* The blue itself. Unity keeps one highlight colour for everything it
       wants to draw attention to, and a focused text field is one of them. */
    --unity-colors-highlight: var(--accent);
    --unity-colors-highlight-background: var(--surface-hover);
    --unity-colors-highlight-background-inactive: var(--surface-hover);
    --unity-colors-default-border: var(--line);
}


/* --------------------------------------------------------------------------
   BOX

   Text colour is set wherever a background is, and on the element that holds
   the letters as well: a rule that paints one without the other is how this
   theme has produced unreadable controls before.
   -------------------------------------------------------------------------- */

.input > .unity-base-text-field__input {
    min-height: var(--control-height);

    background-color: var(--surface);
    background-image: none;

    color: var(--text);
    font-size: var(--font-size-s);

    border-width: var(--border);

    border-color: var(--line);

    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);

    padding-left: var(--space-s);
    padding-right: var(--space-s);
    padding-top: 0;
    padding-bottom: 0;

    -unity-text-align: middle-left;

    transition-property:
        background-color,
        border-color;

    transition-duration: var(--motion-normal);
    transition-timing-function: var(--ease-standard);
}

.input > .unity-base-text-field__input TextElement,
.input > .unity-base-text-field__input Label {
    color: var(--text);
    font-size: var(--font-size-s);

    -unity-text-align: middle-left;
}


/* --------------------------------------------------------------------------
   HOVER
   -------------------------------------------------------------------------- */

.input:hover > .unity-base-text-field__input {
    background-color: var(--surface-hover);

    border-color: var(--line-strong);
}

.input:hover > .unity-base-text-field__input TextElement,
.input:hover > .unity-base-text-field__input Label {
    color: var(--text);
}


/* --------------------------------------------------------------------------
   FOCUS

   The one control a player types into says so plainly: while it has the
   caret, its outline is the accent.
   -------------------------------------------------------------------------- */

/* Three selectors for one state, because the element that takes focus is the
   box inside the field rather than the field, and the class is doubled to get
   above Unity's own rule for it - the same trick the dropdown needed. */

.input.unity-text-field:focus > .unity-base-text-field__input,
.input.unity-text-field > .unity-base-text-field__input:focus,
.input.unity-text-field > .unity-base-text-field__input:focus:hover {
    background-color: var(--surface-hover);

    border-color: var(--accent);
}

.input.unity-text-field:focus > .unity-base-text-field__input TextElement,
.input.unity-text-field > .unity-base-text-field__input:focus TextElement {
    color: var(--text);
}


/* --------------------------------------------------------------------------
   DISABLED
   -------------------------------------------------------------------------- */

.input:disabled > .unity-base-text-field__input {
    background-color: var(--surface);

    border-color: var(--text-disabled);
}

.input:disabled > .unity-base-text-field__input TextElement,
.input:disabled > .unity-base-text-field__input Label {
    color: var(--text-disabled);
}


/* Validation is written last so hover and retained focus cannot make an
   invalid address look valid again before its value changes. */

.input--invalid.unity-text-field > .unity-base-text-field__input,
.input--invalid.unity-text-field:hover > .unity-base-text-field__input,
.input--invalid.unity-text-field:focus > .unity-base-text-field__input,
.input--invalid.unity-text-field > .unity-base-text-field__input:focus,
.input--invalid.unity-text-field > .unity-base-text-field__input:focus:hover {
    border-color: var(--danger);
}
