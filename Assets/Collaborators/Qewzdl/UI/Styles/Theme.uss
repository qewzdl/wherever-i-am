/* ==========================================================================
   GLOBAL UI THEME

   The whole interface, assembled from parts. Nothing is declared here: this
   file exists so that a screen, a panel settings asset or the UI Builder can
   ask for one stylesheet and get all of them, in an order that is stated
   rather than remembered.

   Tokens come first - everything below reads from them. The rest is grouped
   the way the elements are: the layer a screen opens into, the panel inside
   it, and then one file per control.
   ========================================================================== */

@import url("Tokens.uss");

@import url("Screen.uss");
@import url("Panel.uss");
@import url("Typography.uss");

@import url("Button.uss");
@import url("Tabs.uss");
@import url("Field.uss");
@import url("TextField.uss");
@import url("Slider.uss");
@import url("Toggle.uss");
@import url("Dropdown.uss");

/* Last, and on purpose. The lobby trims a button, recolours a field and takes
   the form rows apart to fit a column, and a rule that modifies a control has
   to be read after the control it modifies - they carry the same weight, so
   order is the only thing deciding them. */
@import url("Lobby.uss");
