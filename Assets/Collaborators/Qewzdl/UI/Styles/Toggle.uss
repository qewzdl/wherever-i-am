/* ==========================================================================
   TOGGLE

   Structure:

   .unity-toggle.toggle
       └── .unity-toggle__input
               └── .unity-toggle__checkmark

   Hung off .toggle, which is the control, the way .button, .input and .tab
   are. It used to hang off .field__control - the class that says a control
   stands in the right-hand column of a form row - and that quietly made the
   look of a checkbox conditional on where it was standing. The first toggle
   put anywhere else, on the lobby's door, came out as Unity's own grey tick
   box in the middle of this interface, and nothing about the markup said why.

   A control carries what it looks like; a row says how it sits. Two classes,
   and a toggle in a form row wears both.

   Unity's built-in checkbox graphics are fully suppressed for every relevant
   state. The input draws the outer box, while the checkmark element draws the
   inner fill when the toggle is enabled.

   This avoids Unity restoring its own checkmark image after the control keeps
   focus following a click.
   ========================================================================== */


/* --------------------------------------------------------------------------
   UNITY THEME OVERRIDES
   -------------------------------------------------------------------------- */

.unity-toggle.toggle {
    --unity-colors-toggle_checkmark-background: var(--transparent);
    --unity-colors-toggle_checkmark-background-disabled: var(--transparent);

    --unity-colors-toggle_checkmark-border: var(--line);
    --unity-colors-toggle_checkmark-border-hover: var(--accent);
    --unity-colors-toggle_checkmark-border-focus: var(--accent);
    --unity-colors-toggle_checkmark-border-pressed: var(--accent-pressed);
    --unity-colors-toggle_checkmark-border-disabled: var(--text-disabled);
}


/* --------------------------------------------------------------------------
   BOX
   -------------------------------------------------------------------------- */

.unity-toggle.toggle > .unity-toggle__input {
    width: var(--checkbox-size);
    height: var(--checkbox-size);

    min-width: var(--checkbox-size);
    min-height: var(--checkbox-size);

    flex-grow: 0;
    flex-shrink: 0;

    align-items: center;
    justify-content: center;

    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;

    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;

    background-image: none;
    background-color: var(--transparent);

    border-width: var(--border);

    border-color: var(--line);

    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);

    scale: 1 1;

    transition-property:
        border-color,
        scale;

    transition-duration: var(--motion-fast);
    transition-timing-function: var(--ease-standard);
}


/* --------------------------------------------------------------------------
   MARK
   -------------------------------------------------------------------------- */

.unity-toggle.toggle
> .unity-toggle__input
> .unity-toggle__checkmark {
    width: var(--checkbox-mark-size);
    height: var(--checkbox-mark-size);

    min-width: var(--checkbox-mark-size);
    min-height: var(--checkbox-mark-size);

    flex-grow: 0;
    flex-shrink: 0;

    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;

    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;

    background-image: none;
    background-color: var(--transparent);

    border-width: 0;

    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);

    transition-property: background-color;
    transition-duration: var(--motion-fast);
    transition-timing-function: var(--ease-standard);
}


/* ==========================================================================
   FORCE REMOVE UNITY CHECKMARK IMAGES

   Unity can assign different background images for normal, hover, focus,
   active and checked combinations. Each relevant state explicitly removes
   those images so that focus retained after clicking cannot restore them.
   ========================================================================== */

.unity-toggle.toggle
> .unity-toggle__input
> .unity-toggle__checkmark,

.unity-toggle.toggle:hover
> .unity-toggle__input
> .unity-toggle__checkmark,

.unity-toggle.toggle:focus
> .unity-toggle__input
> .unity-toggle__checkmark,

.unity-toggle.toggle:active
> .unity-toggle__input
> .unity-toggle__checkmark,

.unity-toggle.toggle:checked
> .unity-toggle__input
> .unity-toggle__checkmark,

.unity-toggle.toggle:checked:hover
> .unity-toggle__input
> .unity-toggle__checkmark,

.unity-toggle.toggle:checked:focus
> .unity-toggle__input
> .unity-toggle__checkmark,

.unity-toggle.toggle:checked:active
> .unity-toggle__input
> .unity-toggle__checkmark,

.unity-toggle.toggle:checked:hover:focus
> .unity-toggle__input
> .unity-toggle__checkmark,

.unity-toggle.toggle:checked:active:focus
> .unity-toggle__input
> .unity-toggle__checkmark,

.unity-toggle.toggle:disabled
> .unity-toggle__input
> .unity-toggle__checkmark,

.unity-toggle.toggle:checked:disabled
> .unity-toggle__input
> .unity-toggle__checkmark {
    background-image: none;
}


/* --------------------------------------------------------------------------
   HOVER
   -------------------------------------------------------------------------- */

.unity-toggle.toggle:hover
> .unity-toggle__input {
    border-color: var(--accent);
}


/* --------------------------------------------------------------------------
   FOCUS

   Focus remains after the mouse is moved away following a click, so both the
   box and mark are explicitly styled here.
   -------------------------------------------------------------------------- */

.unity-toggle.toggle:focus
> .unity-toggle__input {
    background-image: none;
    background-color: var(--transparent);

    border-color: var(--accent);
}

.unity-toggle.toggle:focus
> .unity-toggle__input
> .unity-toggle__checkmark {
    background-image: none;
    background-color: var(--transparent);
}


/* --------------------------------------------------------------------------
   PRESSED
   -------------------------------------------------------------------------- */

.unity-toggle.toggle:active
> .unity-toggle__input {
    scale: 0.9 0.9;

    border-color: var(--accent-pressed);
}


/* --------------------------------------------------------------------------
   CHECKED
   -------------------------------------------------------------------------- */

.unity-toggle.toggle:checked
> .unity-toggle__input
> .unity-toggle__checkmark {
    background-image: none;
    background-color: var(--accent);
}


/* --------------------------------------------------------------------------
   CHECKED + HOVER
   -------------------------------------------------------------------------- */

.unity-toggle.toggle:checked:hover
> .unity-toggle__input
> .unity-toggle__checkmark {
    background-image: none;
    background-color: var(--accent-hover);
}


/* --------------------------------------------------------------------------
   CHECKED + FOCUS

   This is the important state after:
   click -> release -> move cursor away.

   The control remains :checked:focus even when :hover disappears.
   -------------------------------------------------------------------------- */

.unity-toggle.toggle:checked:focus
> .unity-toggle__input {
    background-image: none;
    background-color: var(--transparent);

    border-color: var(--accent);

    scale: 1 1;
}

.unity-toggle.toggle:checked:focus
> .unity-toggle__input
> .unity-toggle__checkmark {
    background-image: none;
    background-color: var(--accent);
}


/* --------------------------------------------------------------------------
   CHECKED + HOVER + FOCUS
   -------------------------------------------------------------------------- */

.unity-toggle.toggle:checked:hover:focus
> .unity-toggle__input {
    border-color: var(--accent-hover);
}

.unity-toggle.toggle:checked:hover:focus
> .unity-toggle__input
> .unity-toggle__checkmark {
    background-image: none;
    background-color: var(--accent-hover);
}


/* --------------------------------------------------------------------------
   CHECKED + PRESSED
   -------------------------------------------------------------------------- */

.unity-toggle.toggle:checked:active
> .unity-toggle__input {
    scale: 0.9 0.9;

    border-color: var(--accent-pressed);
}

.unity-toggle.toggle:checked:active
> .unity-toggle__input
> .unity-toggle__checkmark {
    background-image: none;
    background-color: var(--accent-pressed);
}


/* --------------------------------------------------------------------------
   CHECKED + PRESSED + FOCUS
   -------------------------------------------------------------------------- */

.unity-toggle.toggle:checked:active:focus
> .unity-toggle__input {
    scale: 0.9 0.9;

    border-color: var(--accent-pressed);
}

.unity-toggle.toggle:checked:active:focus
> .unity-toggle__input
> .unity-toggle__checkmark {
    background-image: none;
    background-color: var(--accent-pressed);
}


/* --------------------------------------------------------------------------
   UNCHECKED + HOVER + FOCUS
   -------------------------------------------------------------------------- */

.unity-toggle.toggle:hover:focus
> .unity-toggle__input {
    background-image: none;
    background-color: var(--transparent);

    border-color: var(--accent);
}

.unity-toggle.toggle:hover:focus
> .unity-toggle__input
> .unity-toggle__checkmark {
    background-image: none;
    background-color: var(--transparent);
}


/* --------------------------------------------------------------------------
   DISABLED
   -------------------------------------------------------------------------- */

.unity-toggle.toggle:disabled
> .unity-toggle__input {
    background-image: none;
    background-color: var(--transparent);

    border-color: var(--text-disabled);

    scale: 1 1;

    opacity: 0.55;
}

.unity-toggle.toggle:disabled
> .unity-toggle__input
> .unity-toggle__checkmark {
    background-image: none;
    background-color: var(--transparent);
}


/* --------------------------------------------------------------------------
   CHECKED + DISABLED
   -------------------------------------------------------------------------- */

.unity-toggle.toggle:checked:disabled
> .unity-toggle__input {
    background-image: none;
    background-color: var(--transparent);

    border-color: var(--text-disabled);

    scale: 1 1;

    opacity: 0.55;
}

.unity-toggle.toggle:checked:disabled
> .unity-toggle__input
> .unity-toggle__checkmark {
    background-image: none;
    background-color: var(--text-disabled);
}